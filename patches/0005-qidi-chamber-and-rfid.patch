+std::optional<std::string> QidiPrinterAgent::control_script(const nlohmann::json& command)
+{
+    if (!command.is_object() || !command.contains("command") || !command["command"].is_string())
+        return std::nullopt;
+    const auto integer = [&](const char* key, int maximum) {
+        const auto it = command.find(key);
+        if (it == command.end() || !it->is_number_integer() || *it < 0 || *it > maximum)
+            throw std::invalid_argument("Invalid QIDI control parameter");
+        return it->get<int>();
+    };
+    const std::string name = command["command"].get<std::string>();
+    // Commands from QIDI Studio's PrinterTaskDispatcher::build_local_task.
+    if (name == "set_ctt")
+        return "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=" + std::to_string(integer("ctt_val", 65));
+    if (name == "ams_get_rfid")
+        return "READ_RFID SLOT=" + std::to_string(integer("ams_id", 3) * 4 + integer("slot_id", 3));
+    return std::nullopt;
+}
+
+int QidiPrinterAgent::send_message(std::string dev_id, std::string json_str, int qos, int flag)
+{
+    auto request = nlohmann::json::parse(json_str, nullptr, false);
+    if (request.is_object() && request.contains("print")) {
+        try {
+            if (auto script = control_script(request["print"])) {
+                request["print"]["command"] = "gcode_line";
+                request["print"]["param"] = *script;
+                return MoonrakerPrinterAgent::send_message(std::move(dev_id), request.dump(), qos, flag);
+            }
+        } catch (const std::exception&) {
+            return BAMBU_NETWORK_ERR_INVALID_RESULT;
+        }
+    }
+    return MoonrakerPrinterAgent::send_message(std::move(dev_id), std::move(json_str), qos, flag);
+}
+
+int QidiPrinterAgent::send_message_to_printer(std::string dev_id, std::string json_str, int qos, int flag)
+{
+    return send_message(std::move(dev_id), std::move(json_str), qos, flag);
+}
+
+void QidiPrinterAgent::append_chamber_status(const nlohmann::json& status, nlohmann::json& payload)
+{
+    const auto chamber = status.find("heater_generic chamber");
+    if (chamber == status.end() || !chamber->is_object())
+        return;
+    if (chamber->contains("temperature") && (*chamber)["temperature"].is_number())
+        payload["print"]["chamber_temper"] = (*chamber)["temperature"];
+    if (chamber->contains("target") && (*chamber)["target"].is_number())
+        payload["print"]["ctt"] = (*chamber)["target"];
+}
