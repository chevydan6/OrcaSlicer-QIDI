+TEST_CASE("QIDI chamber and RFID controls use the local printer protocol", "[QidiPrinterAgent]")
+{
+    CHECK(QidiPrinterAgent::control_script({{"command", "set_ctt"}, {"ctt_val", 45}}) ==
+          "SET_HEATER_TEMPERATURE HEATER=chamber TARGET=45");
+    CHECK(QidiPrinterAgent::control_script({{"command", "ams_get_rfid"}, {"ams_id", 1}, {"slot_id", 2}}) ==
+          "READ_RFID SLOT=6");
+    CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "set_ctt"}, {"ctt_val", 66}}));
+    CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "set_ctt"}, {"ctt_val", "45\nG28"}}));
+    CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "ams_get_rfid"}, {"ams_id", 4}, {"slot_id", 0}}));
+    CHECK_FALSE(QidiPrinterAgent::control_script({{"command", "pause"}}).has_value());
+}
+
+TEST_CASE("QIDI chamber telemetry carries measured and requested temperatures", "[QidiPrinterAgent]")
+{
+    nlohmann::json payload;
+    QidiPrinterAgent::append_chamber_status({{"heater_generic chamber", {{"temperature", 42.5}, {"target", 55}}}}, payload);
+    CHECK(payload["print"]["chamber_temper"] == 42.5);
+    CHECK(payload["print"]["ctt"] == 55);
+    payload = nlohmann::json::object();
+    QidiPrinterAgent::append_chamber_status({{"heater_generic chamber", {{"temperature", "bad"}, {"target", nullptr}}}}, payload);
+    CHECK(payload.empty());
+}
