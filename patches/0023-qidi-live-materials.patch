+
+TEST_CASE("QIDI partial slot updates preserve synchronized material identity", "[QidiPrinterAgent]")
+{
+    DevAmsTray tray("2");
+    tray.setting_id = "specific-PLA-preset";
+    tray.m_fila_type = "PLA";
+    tray.color = "112233FF";
+    tray.is_exists = true;
+    DevFilaSystemParser::UpdateQidiTray(tray, {{"filament_type", "PLA"}, {"present", true}}, "generic-PLA-preset");
+    CHECK(tray.setting_id == "specific-PLA-preset");
+    CHECK(tray.color == "112233FF");
+    DevFilaSystemParser::UpdateQidiTray(tray, {{"filament_type", "PETG"}, {"color", "#ABCDEF"}}, "PETG-preset");
+    CHECK(tray.setting_id == "PETG-preset");
+    CHECK(tray.color == "ABCDEFFF");
+    DevFilaSystemParser::UpdateQidiTray(tray, {{"present", false}, {"color", "bad-color"}}, "");
+    CHECK_FALSE(tray.is_exists);
+    CHECK(tray.is_slot_placeholder);
+    CHECK(tray.setting_id == "PETG-preset");
+    CHECK(tray.color == "ABCDEFFF");
+    tray.hold_count = 1;
+    DevFilaSystemParser::UpdateQidiTray(tray, {{"present", true}}, "");
+    CHECK_FALSE(tray.is_exists);
+    DevFilaSystemParser::UpdateQidiTray(tray, {{"present", true}, {"filament_type", "unknown material"}}, "");
+    CHECK(tray.is_exists);
+    CHECK(tray.is_slot_placeholder);
+    CHECK(tray.setting_id.empty());
+}
