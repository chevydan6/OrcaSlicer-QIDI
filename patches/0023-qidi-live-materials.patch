         const auto humidity = box.find(prefix + "aht20_humidity");
         if (humidity != box.end() && humidity->is_number() && *humidity >= 0 && *humidity <= 100)
             unit["humidity_raw"] = std::to_string(humidity->get<int>());
-        // No tray key: telemetry must preserve synchronized filament metadata.
+        // Separate partial slot updates from Bambu's complete tray-list protocol.
+        // Temperature-only reports must never delete synchronized tray metadata.
+        for (int slot = 0; slot < 4; ++slot) {
+            auto decoded = decoded_box_slot(status, i * 4 + slot);
+            if (!decoded.empty()) {
+                decoded["id"] = std::to_string(slot);
+                unit["qidi_slots"].push_back(std::move(decoded));
+            }
+        }
         units.push_back(std::move(unit));
     }
     std::ostringstream bits;
