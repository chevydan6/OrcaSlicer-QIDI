+void DevFilaSystemParser::UpdateQidiTray(DevAmsTray& tray, const nlohmann::json& update,
+                                         const std::string& resolved_filament_id)
+{
+    if (tray.hold_count > 0) {
+        --tray.hold_count;
+        return;
+    }
+    if (update.contains("present") && update["present"].is_boolean())
+        tray.is_exists = update["present"].get<bool>();
+    if (update.contains("filament_type") && update["filament_type"].is_string()) {
+        const auto type = update["filament_type"].get<std::string>();
+        const auto name = update.value("filament_str", tray.sub_brands);
+        if (type != tray.m_fila_type || name != tray.sub_brands || tray.setting_id.empty())
+            tray.setting_id = resolved_filament_id;
+        tray.m_fila_type = type;
+        tray.sub_brands = name;
+    }
+    if (update.contains("color") && update["color"].is_string()) {
+        auto color = update["color"].get<std::string>();
+        if (!color.empty() && color.front() == '#') color.erase(0, 1);
+        if (color.size() > 2 && color.substr(0, 2) == "0x") color.erase(0, 2);
+        if ((color.size() == 6 || color.size() == 8) &&
+            std::all_of(color.begin(), color.end(), [](unsigned char c) { return std::isxdigit(c) != 0; })) {
+            if (color.size() == 6) color += "FF";
+            tray.UpdateColorFromStr(color);
+            tray.cols = {color};
+            tray.ctype = 1;
+        }
+    }
+    tray.is_slot_placeholder = !tray.is_exists || tray.setting_id.empty();
+}
+
 void DevFilaSystemParser::ParseV1_0(const json& jj, MachineObject* obj, DevFilaSystem* system, bool key_field_only)
 {
     if (jj.contains("ams"))
@@ -646,6 +682,40 @@ void DevFilaSystemParser::ParseV1_0(const json& jj, MachineObject* obj, DevFilaS
                         }
                     }
 
+                    if (obj->printer_agent_id == "qidi" && it->contains("qidi_slots") && (*it)["qidi_slots"].is_array()) {
+                        for (const auto& update : (*it)["qidi_slots"]) {
+                            if (!update.is_object() || !update.contains("id") || !update["id"].is_string()) continue;
+                            const auto id = update["id"].get<std::string>();
+                            if (id != "0" && id != "1" && id != "2" && id != "3") continue;
+                            if (ams_id != "0" && ams_id != "1" && ams_id != "2" && ams_id != "3") continue;
+                            auto* tray = curr_ams->GetTray(id);
+                            if (!tray) {
+                                tray = new DevAmsTray(id);
+                                curr_ams->m_trays.emplace(id, tray);
+                            }
+                            std::string resolved_id;
+                            auto* bundle = GUI::wxGetApp().preset_bundle;
+                            if (bundle && update.contains("filament_type") && update["filament_type"].is_string()) {
+                                const auto type = update["filament_type"].get<std::string>();
+                                const auto name = update.value("filament_str", std::string());
+                                for (const auto& preset : bundle->filaments.get_presets()) {
+                                    if (!preset.is_visible || !preset.is_compatible) continue;
+                                    const auto* types = preset.config.option<ConfigOptionStrings>("filament_type");
+                                    if (!types || types->values.empty() || types->values.front() != type) continue;
+                                    if (resolved_id.empty()) resolved_id = preset.filament_id;
+                                    if (!name.empty() && (preset.alias == name || preset.name == name)) {
+                                        resolved_id = preset.filament_id;
+                                        break;
+                                    }
+                                }
+                            }
+                            UpdateQidiTray(*tray, update, resolved_id);
+                            const auto bit = 1UL << ((ams_id[0] - '0') * 4 + (id[0] - '0'));
+                            if (tray->is_exists) obj->tray_exist_bits |= bit;
+                            else obj->tray_exist_bits &= ~bit;
+                        }
+                    }
+
                     if (it->contains("tray"))
                     {
                         std::set<std::string> tray_id_set;
