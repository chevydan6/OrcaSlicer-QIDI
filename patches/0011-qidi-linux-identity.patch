diff --git a/resources/qidi-port-notice.txt b/resources/qidi-port-notice.txt
new file mode 100644
index 00000000..e5b68141
--- /dev/null
+++ b/resources/qidi-port-notice.txt
@@ -0,0 +1,25 @@
+OrcaSlicer QIDI personal downstream build
+
+Based on official OrcaSlicer:
+https://github.com/OrcaSlicer/OrcaSlicer
+Revision 896557bce5281553ee0c6210f2da301b3b3c262e
+
+MAX4 profiles and QIDI Box behavior adapted from QIDI Studio:
+https://github.com/QIDITECH/QIDIStudio
+Revision 403b619d56147160bb883e94f95a7951245bc6d0
+Copyright remains with the respective upstream contributors.
+
+Distributed under GNU Affero General Public License version 3, as are the
+upstream projects. See LICENSE for the complete license. This is a personal
+integration, not an official OrcaSlicer or QIDI release.
+
+The integration repository records source pins, patches, build instructions,
+feature status and validation limitations:
+https://github.com/chevydan6/OrcaSlicer-QIDI
+It is currently a private personal backup. Before distributing binaries to
+others, make the corresponding source available to those recipients.
+
+Linux settings default to the separate OrcaSlicer-QIDI configuration directory.
+Do not replace this build with an official application update if you need the
+downstream additions. Firmware compatibility and physical printer behavior
+require separate verification; software tests do not certify physical operation.
diff --git a/src/libslic3r/utils.cpp b/src/libslic3r/utils.cpp
index 4ba6d9d9..303d40e9 100644
--- a/src/libslic3r/utils.cpp
+++ b/src/libslic3r/utils.cpp
@@ -408,7 +408,9 @@ std::string default_data_dir()
     const boost::filesystem::path portable = boost::dll::program_location(ec).parent_path() / "data_dir";
     if (!ec && boost::filesystem::exists(portable, ec))
         return portable.string();
-    return xdg_config_dir(SLIC3R_APP_KEY);
+    // The downstream Linux build coexists with upstream even when launched
+    // directly, without its installer wrapper. Keep the translation catalog key.
+    return xdg_config_dir("OrcaSlicer-QIDI");
 }
 #endif
 
diff --git a/tests/libslic3r/test_utils.cpp b/tests/libslic3r/test_utils.cpp
index 3b3f10df..1c022822 100644
--- a/tests/libslic3r/test_utils.cpp
+++ b/tests/libslic3r/test_utils.cpp
@@ -587,6 +587,6 @@ TEST_CASE("xdg_config_dir follows XDG_CONFIG_HOME and falls back to ~/.config",
 TEST_CASE("default_data_dir is the XDG config dir without a portable data_dir folder", "[utils]") {
     ScopedEnvVar xdg("XDG_CONFIG_HOME", "/tmp/xdg-test");
     // A data_dir folder next to the test binary would make it a portable install; none is expected.
-    CHECK(Slic3r::default_data_dir() == "/tmp/xdg-test/" SLIC3R_APP_KEY);
+    CHECK(Slic3r::default_data_dir() == "/tmp/xdg-test/OrcaSlicer-QIDI");
 }
 #endif
