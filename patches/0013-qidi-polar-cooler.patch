+nlohmann::json QidiPrinterAgent::configuration_notification(const nlohmann::json& notification)
+{
+    nlohmann::json status = nlohmann::json::object();
+    if (!notification.is_object() || !notification.contains("method") || notification["method"] != "notify_proc_stat_update" ||
+        !notification.contains("params") || !notification["params"].is_array() || notification["params"].empty())
+        return status;
+    const auto& data = notification["params"][0];
+    if (!data.is_object() || !data.contains("config_items") || !data["config_items"].is_object())
+        return status;
+    const auto value = data["config_items"].find("printing.polar_cooler");
+    if (value != data["config_items"].end() && value->is_string() && (*value == "0" || *value == "1"))
+        status["qidi_config"]["polar_cooler_available"] = *value == "1";
+    return status;
+}
