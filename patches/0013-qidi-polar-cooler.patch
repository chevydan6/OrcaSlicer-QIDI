+
+TEST_CASE("QIDI Polar Cooler availability follows the firmware configuration report", "[QidiPrinterAgent]")
+{
+    const std::string installed = GENERATE(std::string("0"), std::string("1"));
+    const nlohmann::json notification{{"method", "notify_proc_stat_update"},
+        {"params", nlohmann::json::array({{{"config_items", {{"printing.polar_cooler", installed}}}}})}};
+    const auto status = QidiPrinterAgent::configuration_notification(notification);
+    nlohmann::json payload;
+    QidiPrinterAgent::append_accessory_status(status, payload);
+    CHECK(payload["print"]["qidi_polar_cooler_available"] == (installed == "1"));
+    CHECK(QidiPrinterAgent::configuration_notification({{"method", "notify_status_update"}}).empty());
+}
