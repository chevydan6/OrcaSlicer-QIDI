+    if (options.is_object() && options.contains("qidi") && options["qidi"].is_object() && options["qidi"].contains("polar_cooler")) {
+        const auto& value = options["qidi"]["polar_cooler"];
+        if (!value.is_boolean() || !send_gcode_sync(device_info.dev_id,
+            std::string("SAVE_VARIABLE VARIABLE=enable_polar_cooler VALUE=") + (value.get<bool>() ? "1" : "0")))
+            return false;
+    }
 
     // On the X-Max 4 and Q2, Klipper only opens the copy Moonraker's print start makes, so SDCARD_PRINT_FILE can't find the upload
     std::string response;
