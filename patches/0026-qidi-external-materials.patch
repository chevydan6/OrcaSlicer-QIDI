-                                    if (!types || types->values.empty() || types->values.front() != type) continue;
-                                    if (resolved_id.empty()) resolved_id = preset.filament_id;
-                                    if (!name.empty() && (preset.alias == name || preset.name == name)) {
-                                        resolved_id = preset.filament_id;
-                                        break;
-                                    }
-                                }
-                            }
+                            if (bundle) resolved_id = ResolveQidiFilament(update, bundle->filaments);
                             UpdateQidiTray(*tray, update, resolved_id);
                             const auto bit = 1UL << ((ams_id[0] - '0') * 4 + (id[0] - '0'));
