+TEST_CASE("QIDI external spool metadata is independent of Box count", "[QidiPrinterAgent]")
+{
+    nlohmann::json payload;
+    QidiPrinterAgent::append_box_status({{"multi_color_controller", {{"extra", {{"filament_info", {
+        {"filament_type", "PLA"}, {"filament_str", "QIDI PLA Rapido"}, {"color_rgb_str", {"112233"}}}}}}}}}, payload);
+    CHECK(payload["print"]["qidi_external_slot"]["present"] == true);
+    CHECK(payload["print"]["qidi_external_slot"]["filament_type"] == "PLA");
+    CHECK(payload["print"]["qidi_external_slot"]["color"] == "112233");
+    CHECK_FALSE(payload["print"].contains("ams"));
