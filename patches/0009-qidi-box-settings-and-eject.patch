     Bind(EVT_AMS_EXTRUSION_CALI, &StatusPanel::on_filament_extrusion_cali, this);
     Bind(EVT_AMS_LOAD, &StatusPanel::on_ams_load, this);
     Bind(EVT_AMS_UNLOAD, &StatusPanel::on_ams_unload, this);
+    Bind(EVT_QIDI_BOX_EJECT, [this](SimpleEvent&) {
+        if (!obj || obj->printer_agent_id != "qidi" || obj->is_in_printing())
+            return;
+        const auto ams_id = m_ams_control->GetCurentAms();
+        const auto slot_id = m_ams_control->GetCurrentCan(ams_id);
+        const auto* unit = obj->GetFilaSystem()->GetAmsById(ams_id);
+        if (!unit || unit->m_qidi_box_identity == "box_v2")
+            return;
+        try {
+            const int box = std::stoi(ams_id);
+            const int slot = std::stoi(slot_id);
+            if (box < 0 || box > 3 || slot < 0 || slot > 3)
+                return;
+            nlohmann::json request{{"print", {{"command", "ams_eject_filament"}, {"ams_id", box}, {"slot_id", slot}}}};
+            obj->publish_json(request);
+        } catch (const std::exception&) {
+            // No physical slot is selected (for example the external spool).
+        }
+    });
     Bind(EVT_AMS_SWITCH, &StatusPanel::on_ams_switch, this);
     Bind(EVT_AMS_FILAMENT_BACKUP, &StatusPanel::on_ams_filament_backup, this);
     Bind(EVT_AMS_SETTINGS, &StatusPanel::on_ams_setting_click, this);
