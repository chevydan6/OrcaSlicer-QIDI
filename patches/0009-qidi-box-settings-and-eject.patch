diff --git a/src/slic3r/Utils/QidiPrinterAgent.cpp b/src/slic3r/Utils/QidiPrinterAgent.cpp
index 2b1a7ced..59aec0d9 100644
--- a/src/slic3r/Utils/QidiPrinterAgent.cpp
+++ b/src/slic3r/Utils/QidiPrinterAgent.cpp
@@ -13,6 +13,7 @@
 #include <boost/algorithm/string/case_conv.hpp>
 #include <boost/log/trivial.hpp>
 #include <cctype>
+#include <algorithm>
 #include <ios>
 #include "libslic3r/Preset.hpp"
 #include <map>
@@ -68,6 +69,39 @@ std::optional<std::string> QidiPrinterAgent::control_script(const nlohmann::json
     }
     if (name == "ams_get_rfid")
         return "READ_RFID SLOT=" + std::to_string(integer("ams_id", 3) * 4 + integer("slot_id", 3));
+    if (name == "ams_eject_filament")
+        return "EJECT_FILAMENT_CONTROL SLOT=" + std::to_string(integer("ams_id", 3) * 4 + integer("slot_id", 3));
+    if (name == "ams_user_setting") {
+        const auto flag = [&](const char* key) {
+            const auto value = command.find(key);
+            if (value == command.end() || !value->is_boolean())
+                throw std::invalid_argument("Invalid QIDI RFID setting");
+            return value->get<bool>() ? "1" : "0";
+        };
+        return std::string("SET_ENABLE_RFID_READ ENABLE=\"") + flag("tray_read_option") + "\"\n"
+            + "SET_ENABLE_INIT_READ_RFID ENABLE=\"" + flag("startup_read_option") + "\"";
+    }
+    if (name == "ams_filament_setting") {
+        // QIDI's material table has an additional external-spool entry at 16.
+        const int ams_id = integer("ams_id", 255);
+        const int slot = ams_id == 255 ? (integer("slot_id", 0), 16) : integer("ams_id", 3) * 4 + integer("slot_id", 3);
+        const auto literal = [&](const char* key) {
+            const auto value = command.find(key);
+            if (value == command.end() || !value->is_string())
+                throw std::invalid_argument("Invalid QIDI filament description");
+            const std::string text = value->get<std::string>();
+            if (text.size() > 128 || text.find_first_of("'\"\\;\r\n") != std::string::npos ||
+                std::any_of(text.begin(), text.end(), [](unsigned char c) { return c < 32; }))
+                throw std::invalid_argument("Invalid QIDI filament description");
+            return text;
+        };
+        std::string color = literal("tray_color");
+        if ((color.size() != 6 && color.size() != 8) || !std::all_of(color.begin(), color.end(), [](unsigned char c) { return std::isxdigit(c); }))
+            throw std::invalid_argument("Invalid QIDI filament color");
+        color.resize(6); // Orca's RGBA to QIDI's RGB.
+        return "UPDATE_FILAMENT_INFORMATION SLOT=" + std::to_string(slot) + " COLOR='" + color
+            + "' VENDOR='" + literal("tray_vendor") + "' FILAMENT='" + literal("tray_type") + "'";
+    }
     return std::nullopt;
 }
 
