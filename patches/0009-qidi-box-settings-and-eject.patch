             unit["temp"] = temperature->dump();
@@ -164,6 +202,17 @@ void QidiPrinterAgent::append_box_status(const nlohmann::json& status, nlohmann:
     bits << std::hex << ((1U << *count) - 1U);
     payload["print"]["ams"]["ams"] = std::move(units);
     payload["print"]["ams"]["ams_exist_bits"] = bits.str();
+    const auto read_flag = [&](const char* from, const char* to) {
+        const auto value = controller->find(from);
+        if (value != controller->end()) {
+            if (value->is_boolean())
+                payload["print"]["ams"][to] = *value;
+            else if (value->is_number_integer() && *value >= 0 && *value <= 1)
+                payload["print"]["ams"][to] = value->get<int>() != 0;
+        }
+    };
+    read_flag("auto_read_rfid", "insert_flag");
+    read_flag("auto_init_detect", "power_on_flag");
 }
 
