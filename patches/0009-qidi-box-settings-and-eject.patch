diff --git a/tests/slic3rutils/test_qidi_printer_agent.cpp b/tests/slic3rutils/test_qidi_printer_agent.cpp
index 44f249e4..054c15d1 100644
--- a/tests/slic3rutils/test_qidi_printer_agent.cpp
+++ b/tests/slic3rutils/test_qidi_printer_agent.cpp
@@ -133,3 +133,22 @@ TEST_CASE("QIDI Box telemetry requires a valid known box count", "[QidiPrinterAg
     QidiPrinterAgent::append_box_status({{"multi_color_controller", {{"box_count", count}}}}, payload);
     CHECK(payload.empty());
 }
+
+TEST_CASE("QIDI Box material edits carry the selected slot vendor type and RGB color", "[QidiPrinterAgent]")
+{
+    nlohmann::json request{{"command", "ams_filament_setting"}, {"ams_id", 1}, {"slot_id", 3},
+                           {"tray_color", "FF8000FF"}, {"tray_vendor", "QIDI"}, {"tray_type", "PLA"}};
+    CHECK(QidiPrinterAgent::control_script(request) ==
+          "UPDATE_FILAMENT_INFORMATION SLOT=7 COLOR='FF8000' VENDOR='QIDI' FILAMENT='PLA'");
+    request["tray_type"] = "PLA'\nG28";
+    CHECK_THROWS(QidiPrinterAgent::control_script(request));
+}
+
+TEST_CASE("QIDI Box RFID preferences and eject controls use local macros", "[QidiPrinterAgent]")
+{
+    CHECK(QidiPrinterAgent::control_script({{"command", "ams_user_setting"}, {"tray_read_option", true}, {"startup_read_option", false}}) ==
+          "SET_ENABLE_RFID_READ ENABLE=\"1\"\nSET_ENABLE_INIT_READ_RFID ENABLE=\"0\"");
+    CHECK(QidiPrinterAgent::control_script({{"command", "ams_eject_filament"}, {"ams_id", 2}, {"slot_id", 0}}) ==
+          "EJECT_FILAMENT_CONTROL SLOT=8");
+    CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "ams_user_setting"}, {"tray_read_option", "1"}, {"startup_read_option", false}}));
+}
