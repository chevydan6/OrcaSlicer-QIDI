+++ b/src/slic3r/GUI/DeviceManager.cpp
@@ -1830,6 +1830,23 @@ int MachineObject::command_ams_filament_settings(int ams_id, int slot_id, std::s
     j["print"]["nozzle_temp_min"]   = nozzle_temp_min;
     j["print"]["nozzle_temp_max"]   = nozzle_temp_max;
     j["print"]["tray_type"]         = tray_type;
+    if (printer_agent_id == "qidi") {
+        j["print"]["tray_vendor"] = "Generic";
+        if (const auto* bundle = GUI::wxGetApp().preset_bundle; bundle && !setting_id.empty()) {
+            for (const auto& preset : bundle->filaments.get_presets()) {
+                if (preset.setting_id == setting_id) {
+                    const auto vendor = preset.config.get_filament_vendor();
+                    j["print"]["tray_vendor"] = vendor;
+                    // QIDI records the material product name (e.g. PLA Rapido),
+                    // not only Orca's broad filament_type (PLA).
+                    const auto prefix = vendor + " ";
+                    if (preset.alias.compare(0, prefix.size(), prefix) == 0)
+                        j["print"]["tray_type"] = preset.alias.substr(prefix.size());
+                    break;
+                }
+            }
+        }
+    }
     if (!tray_colors.empty()) {
         j["print"]["cols"]  = tray_colors;
         j["print"]["ctype"] = tray_ctype;
