+std::optional<int> QidiPrinterAgent::reported_box_count(const nlohmann::json& status, bool legacy_default)
+{
+    const nlohmann::json::json_pointer paths[] = {
+        nlohmann::json::json_pointer("/multi_color_controller/box_count"),
+        nlohmann::json::json_pointer("/multi_color_controller/box/box_count"),
+        nlohmann::json::json_pointer("/save_variables/variables/box_count")};
+    for (const auto& path : paths) {
+        if (!status.contains(path))
+            continue;
+        const auto& count = status[path];
+        // Check before narrowing: a malicious or corrupt unsigned count must not wrap.
+        if (!count.is_number_integer() || count < 0 || count > 4)
+            return std::nullopt;
+        return count.get<int>();
+    }
+    return legacy_default ? std::optional<int>(1) : std::nullopt;
+}
+
+nlohmann::json QidiPrinterAgent::decoded_box_slot(const nlohmann::json& status, int slot)
+{
+    nlohmann::json result = nlohmann::json::object();
+    if (slot < 0 || slot >= 16)
+        return result;
+    const auto controller = status.find("multi_color_controller");
+    if (controller == status.end() || !controller->is_object())
+        return result;
+    const auto nested = controller->find("box");
+    const auto& box = nested != controller->end() && nested->is_object() ? *nested : *controller;
+    const auto prefix = "box" + std::to_string(slot / 4) + "_";
+    const auto index = std::to_string(slot % 4);
+    const auto inserted = box.find(prefix + "box_inserted_" + index);
+    if (inserted != box.end() && (inserted->is_boolean() || inserted->is_number_integer()))
+        result["present"] = inserted->is_boolean() ? inserted->get<bool>() : *inserted != 0;
+    for (const char* key : {"filament_type", "filament_str", "vendor_str"}) {
+        const auto value = box.find(prefix + "filament_info_" + index + "_" + key);
+        if (value != box.end() && value->is_string())
+            result[key] = *value;
+    }
+    const auto colors = box.find(prefix + "filament_info_" + index + "_color_rgb_str");
+    if (colors != box.end() && colors->is_array() && !colors->empty() && (*colors)[0].is_string())
+        result["color"] = (*colors)[0];
+    return result;
+}
