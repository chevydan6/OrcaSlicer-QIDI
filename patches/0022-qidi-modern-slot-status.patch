+
+TEST_CASE("QIDI Box count rejects invalid values before integer conversion", "[QidiPrinterAgent]")
+{
+    CHECK(QidiPrinterAgent::reported_box_count({}, true) == 1);
+    CHECK_FALSE(QidiPrinterAgent::reported_box_count({}));
+    CHECK(QidiPrinterAgent::reported_box_count({{"multi_color_controller", {{"box", {{"box_count", 4}}}}}}) == 4);
+    CHECK_FALSE(QidiPrinterAgent::reported_box_count({{"multi_color_controller", {{"box_count", 4294967296ULL}}}}, true));
+    CHECK_FALSE(QidiPrinterAgent::reported_box_count({{"save_variables", {{"variables", {{"box_count", -1}}}}}}, true));
+}
+
+TEST_CASE("QIDI modern slot data keeps physical slot identity in nested and flat reports", "[QidiPrinterAgent]")
+{
+    const bool nested = GENERATE(false, true);
+    const nlohmann::json box{{"box1_box_inserted_2", 1}, {"box1_filament_info_2_filament_type", "PETG"},
+        {"box1_filament_info_2_color_rgb_str", {"AABBCC", "DDEEFF"}}, {"last_load_slot", "slot6"}};
+    const nlohmann::json status{{"multi_color_controller", nested ? nlohmann::json{{"box", box}} : box}};
+    const auto slot = QidiPrinterAgent::decoded_box_slot(status, 6);
+    CHECK(slot["present"] == true);
+    CHECK(slot["filament_type"] == "PETG");
+    CHECK(slot["color"] == "AABBCC");
+    CHECK(QidiPrinterAgent::decoded_box_slot(status, 5).empty());
+    CHECK(QidiPrinterAgent::decoded_box_slot(status, 16).empty());
+    nlohmann::json payload;
+    QidiPrinterAgent::append_box_status(status, payload);
+    CHECK(payload["print"]["ams"]["tray_now"] == "6");
+    CHECK_FALSE(payload["print"]["ams"].contains("ams"));
+}
+
+TEST_CASE("QIDI loaded slot does not interpret malformed firmware names", "[QidiPrinterAgent]")
+{
+    const std::string name = GENERATE(std::string("slot16"), std::string("slot17"), std::string("slot01"), std::string("tool2"));
+    nlohmann::json payload;
+    QidiPrinterAgent::append_box_status({{"multi_color_controller", {{"last_load_slot", name}}}}, payload);
+    if (name == "slot16")
+        CHECK(payload["print"]["ams"]["tray_now"] == "254");
+    else
+        CHECK(payload.empty());
+}
