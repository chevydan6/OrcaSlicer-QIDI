+++ b/src/slic3r/GUI/PrintOptionsDialog.hpp
@@ -84,6 +84,7 @@ protected:
     // settings
     wxScrolledWindow* m_scrollwindow;
     CheckBox* m_cb_first_layer;
+    Button* m_qidi_skip_objects{nullptr};
     CheckBox* m_cb_qidi_polar_cooler{nullptr};
     wxBoxSizer* m_qidi_polar_cooler_sizer{nullptr};
     CheckBox *        m_cb_ai_monitoring;
diff --git a/src/slic3r/Utils/QidiPrinterAgent.cpp b/src/slic3r/Utils/QidiPrinterAgent.cpp
index f6d5a76a..75165ebf 100644
--- a/src/slic3r/Utils/QidiPrinterAgent.cpp
+++ b/src/slic3r/Utils/QidiPrinterAgent.cpp
@@ -61,6 +61,23 @@ std::optional<std::string> QidiPrinterAgent::control_script(const nlohmann::json
     };
     const std::string name = command["command"].get<std::string>();
     // Commands from QIDI Studio's PrinterTaskDispatcher::build_local_task.
+    if (name == "qidi_exclude_objects") {
+        const auto objects = command.find("objects");
+        if (objects == command.end() || !objects->is_array() || objects->empty())
+            throw std::invalid_argument("No QIDI objects selected");
+        std::string script;
+        for (const auto& object : *objects) {
+            if (!object.is_string())
+                throw std::invalid_argument("Invalid QIDI object name");
+            const auto value = object.get<std::string>();
+            if (value.empty() || value.size() > 512 || value.find_first_of(" \t\r\n'\"\\;=#") != std::string::npos ||
+                std::any_of(value.begin(), value.end(), [](unsigned char c) { return c < 32 || c == 127; }))
+                throw std::invalid_argument("Invalid QIDI object name");
+            if (!script.empty()) script += '\n';
+            script += "EXCLUDE_OBJECT NAME=" + value;
+        }
+        return script;
+    }
     if (name == "qidi_polar_cooler") {
         const auto enabled = command.find("enabled");
         if (enabled == command.end() || !enabled->is_boolean())
@@ -215,6 +232,19 @@ AgentInfo QidiPrinterAgent::get_agent_info_static()
 
 void QidiPrinterAgent::append_accessory_status(const nlohmann::json& status, nlohmann::json& payload)
 {
+    const auto exclusion = status.find("exclude_object");
+    if (exclusion != status.end() && exclusion->is_object() && exclusion->contains("objects") && (*exclusion)["objects"].is_array()) {
+        auto names = nlohmann::json::array();
+        const auto excluded = exclusion->find("excluded_objects");
+        for (const auto& object : (*exclusion)["objects"]) {
+            if (!object.is_object() || !object.contains("name") || !object["name"].is_string()) continue;
+            const auto& name = object["name"];
+            if (excluded != exclusion->end() && excluded->is_array() && std::find(excluded->begin(), excluded->end(), name) != excluded->end())
+                continue;
+            names.push_back(name);
+        }
+        payload["print"]["qidi_print_objects"] = std::move(names);
+    }
     const auto cooler = status.find("output_pin polar_cooler");
     if (cooler != status.end() && cooler->is_object() && cooler->contains("value")) {
         const auto& value = (*cooler)["value"];
diff --git a/src/slic3r/Utils/QidiPrinterAgent.hpp b/src/slic3r/Utils/QidiPrinterAgent.hpp
index 5d550d87..4ae57286 100644
--- a/src/slic3r/Utils/QidiPrinterAgent.hpp
+++ b/src/slic3r/Utils/QidiPrinterAgent.hpp
@@ -50,7 +50,7 @@ protected:
     std::vector<std::string> additional_status_objects() const override
     { return {"heater_generic chamber", "multi_color_controller", "save_variables", "output_pin caselight",
               "fan_generic cooling_fan", "fan_generic auxiliary_cooling_fan", "fan_generic chamber_circulation_fan", "gcode_move",
-              "output_pin polar_cooler"}; }
+              "output_pin polar_cooler", "exclude_object"}; }
     void append_status_payload(const nlohmann::json& status, nlohmann::json& payload) const override
     { append_chamber_status(status, payload); append_box_status(status, payload); append_accessory_status(status, payload); }
     nlohmann::json additional_notification_status(const nlohmann::json& notification) const override
diff --git a/tests/slic3rutils/test_qidi_printer_agent.cpp b/tests/slic3rutils/test_qidi_printer_agent.cpp
index 145bf57a..6e2f8b16 100644
--- a/tests/slic3rutils/test_qidi_printer_agent.cpp
+++ b/tests/slic3rutils/test_qidi_printer_agent.cpp
@@ -490,3 +490,14 @@ TEST_CASE("QIDI validates all used tools including support-first and external mo
     params.extra_options = R"({"qidi":{"used_filaments":[4294967296]}})";
     CHECK(QidiPrinterAgent::build_box_selection_script(params).empty());
 }
+
+TEST_CASE("QIDI excludes objects by firmware name and rejects command injection", "[QidiPrinterAgent]")
+{
+    CHECK(QidiPrinterAgent::control_script({{"command", "qidi_exclude_objects"}, {"objects", {"cube_id_5_copy_0", "cube_id_5_copy_1"}}}) ==
+        "EXCLUDE_OBJECT NAME=cube_id_5_copy_0\nEXCLUDE_OBJECT NAME=cube_id_5_copy_1");
+    CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "qidi_exclude_objects"}, {"objects", {"cube", "bad\nG28"}}}));
+    nlohmann::json payload;
+    QidiPrinterAgent::append_accessory_status({{"exclude_object", {{"objects", {{{"name", "cube"}}, {{"name", "tower"}}}},
+        {"excluded_objects", {"tower"}}}}}, payload);
+    CHECK(payload["print"]["qidi_print_objects"] == nlohmann::json::array({"cube"}));
+}
