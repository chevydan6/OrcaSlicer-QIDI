     bool m_support_mqtt_homing { false };// fun[32]
diff --git a/src/slic3r/GUI/PrintOptionsDialog.cpp b/src/slic3r/GUI/PrintOptionsDialog.cpp
index a9e87ed0..97c13ac4 100644
--- a/src/slic3r/GUI/PrintOptionsDialog.cpp
+++ b/src/slic3r/GUI/PrintOptionsDialog.cpp
@@ -28,6 +28,8 @@
 #include "slic3r/GUI/DeviceCore/DevDefs.h"
 #include <wx/utils.h>
 #include <wx/msgdlg.h>
+#include <wx/choicdlg.h>
+#include <wx/arrstr.h>
 #include "I18N.hpp"
 #include "GUI_App.hpp"
 #include "libslic3r/Utils.hpp"
@@ -82,6 +84,23 @@ PrintOptionsDialog::PrintOptionsDialog(wxWindow* parent)
     mainSizer->Fit(this);
     //this->Fit();
 
+    m_qidi_skip_objects->Bind(wxEVT_BUTTON, [this](wxCommandEvent&) {
+        if (!obj || obj->printer_agent_id != "qidi" || !obj->is_in_printing() || obj->qidi_print_objects.empty()) return;
+        auto* target = obj;
+        const auto job = obj->subtask_name;
+        const auto names = obj->qidi_print_objects;
+        wxArrayString choices;
+        for (const auto& name : names) choices.Add(wxString::FromUTF8(name));
+        wxMultiChoiceDialog dialog(this, _L("Select objects to stop printing for the rest of this job."), _L("Skip objects"), choices);
+        if (dialog.ShowModal() != wxID_OK || obj != target || obj->subtask_name != job || !obj->is_in_printing()) return;
+        auto selected = nlohmann::json::array();
+        for (int index : dialog.GetSelections())
+            if (index >= 0 && static_cast<std::size_t>(index) < names.size()) selected.push_back(names[index]);
+        if (!selected.empty())
+            obj->publish_json({{"print", {{"command", "qidi_exclude_objects"}, {"objects", selected},
+                {"sequence_id", std::to_string(MachineObject::m_sequence_id++)}}}});
+    });
+
     m_cb_qidi_polar_cooler->Bind(wxEVT_TOGGLEBUTTON, [this](wxCommandEvent& evt) {
         if (obj && obj->printer_agent_id == "qidi" && obj->qidi_polar_cooler_available && obj->qidi_polar_cooler_on.has_value()) {
             const nlohmann::json request{{"print", {{"command", "qidi_polar_cooler"},
@@ -381,6 +400,8 @@ void PrintOptionsDialog::update_options(MachineObject* obj_)
 {
     if (!obj_) return;
 
+    m_qidi_skip_objects->Show(obj_->printer_agent_id == "qidi" && !obj_->qidi_print_objects.empty());
+    m_qidi_skip_objects->Enable(obj_->is_in_printing());
     const bool show_cooler = obj_->printer_agent_id == "qidi" && obj_->qidi_polar_cooler_available && obj_->qidi_polar_cooler_on.has_value();
     m_qidi_polar_cooler_sizer->Show(show_cooler);
     if (show_cooler)
@@ -837,6 +858,10 @@ wxBoxSizer* PrintOptionsDialog::create_settings_group(wxWindow* parent)
     wxBoxSizer* sizer = new wxBoxSizer(wxVERTICAL);
     wxBoxSizer* line_sizer = new wxBoxSizer(wxHORIZONTAL);
 
+    m_qidi_skip_objects = new Button(parent, _L("Skip objects..."));
+    sizer->Add(m_qidi_skip_objects, 0, wxLEFT | wxRIGHT | wxBOTTOM, FromDIP(18));
+    m_qidi_skip_objects->Hide();
+
     m_qidi_polar_cooler_sizer = new wxBoxSizer(wxHORIZONTAL);
     m_cb_qidi_polar_cooler = new CheckBox(parent);
     auto* cooler_label = new Label(parent, _L("Polar Cooler"));
diff --git a/src/slic3r/GUI/PrintOptionsDialog.hpp b/src/slic3r/GUI/PrintOptionsDialog.hpp
