Subject: [PATCH] Port QIDI named object exclusion to native print options

---
 src/slic3r/GUI/DeviceManager.cpp              |  5 ++++
 src/slic3r/GUI/DeviceManager.hpp              |  1 +
 src/slic3r/GUI/PrintOptionsDialog.cpp         | 25 ++++++++++++++++
 src/slic3r/GUI/PrintOptionsDialog.hpp         |  1 +
 src/slic3r/Utils/QidiPrinterAgent.cpp         | 30 +++++++++++++++++++
 src/slic3r/Utils/QidiPrinterAgent.hpp         |  2 +-
 tests/slic3rutils/test_qidi_printer_agent.cpp | 11 +++++++
 7 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/src/slic3r/GUI/DeviceManager.cpp b/src/slic3r/GUI/DeviceManager.cpp
index 59c143bf..f82c7586 100644
--- a/src/slic3r/GUI/DeviceManager.cpp
+++ b/src/slic3r/GUI/DeviceManager.cpp
@@ -3275,6 +3275,11 @@ int MachineObject::parse_json(std::string tunnel, std::string payload, bool key_
               m_fan->ParseV2_0(jj);
                 m_fila_switch->ParseFilaSwitchInfo(jj);
 
+                if (printer_agent_id == "qidi" && jj.contains("qidi_print_objects") && jj["qidi_print_objects"].is_array()) {
+                    qidi_print_objects.clear();
+                    for (const auto& name : jj["qidi_print_objects"])
+                        if (name.is_string()) qidi_print_objects.push_back(name.get<std::string>());
+                }
                 if (printer_agent_id == "qidi" && jj.contains("qidi_polar_cooler_available") && jj["qidi_polar_cooler_available"].is_boolean())
                     qidi_polar_cooler_available = jj["qidi_polar_cooler_available"].get<bool>();
                 if (printer_agent_id == "qidi" && jj.contains("qidi_polar_cooler_on") && jj["qidi_polar_cooler_on"].is_boolean())
diff --git a/src/slic3r/GUI/DeviceManager.hpp b/src/slic3r/GUI/DeviceManager.hpp
