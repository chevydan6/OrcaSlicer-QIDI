     if (!imex_processed_gcode.empty())
         file.writeln(imex_processed_gcode);
 
+    // QIDI Studio addresses Box temperatures by logical filament. The printer's
+    // tool-to-slot mapping resolves VT indices; do not compact unused filaments.
+    if (m_config.support_box_temp_control.value) {
+        file.writeln("DISABLE_BOX_HEATER");
+        std::string box_command;
+        for (unsigned int filament : tool_ordering.all_extruders()) {
+            if (filament >= 16)
+                throw SlicingError(_(L("QIDI Box supports at most 16 logical filaments.")));
+            box_command += " VT" + std::to_string(filament) + "=" +
+                           std::to_string(m_config.box_temperature.get_at(filament));
+        }
+        if (!box_command.empty())
+            file.writeln("BOX_TEMP_SET" + box_command);
+    }
+
     // Write the custom start G-code
     file.writeln(machine_start_gcode);
