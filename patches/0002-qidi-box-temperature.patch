+TEST_CASE("QIDI Box temperatures retain logical filament indices before machine start", "[GCode][QidiBox]")
+{
+    const bool enabled = GENERATE(false, true);
+    auto config = Test::multifilament_config(2, {
+        {"support_box_temp_control", enabled},
+        {"box_temperature", "35,45"},
+        {"filament_self_index", "1,2"},
+        {"filament_extruder_variant", "Direct Drive Standard;Direct Drive Standard"},
+        {"enable_prime_tower", 0},
+        {"sparse_infill_filament_id", 2},
+        {"internal_solid_filament_id", 2},
+        {"top_surface_filament_id", 2},
+        {"bottom_surface_filament_id", 2},
+        {"outer_wall_filament_id", 2},
+        {"inner_wall_filament_id", 2},
+        {"skirt_loops", 0},
+        {"brim_type", "no_brim"},
+        {"machine_start_gcode", ";QIDI_TEST_START"},
+    });
+    const std::string gcode = Test::slice({Test::cube(2)}, config);
+    const auto command = gcode.find("\nBOX_TEMP_SET VT1=45\n");
+    if (enabled) {
+        REQUIRE(command != std::string::npos);
+        CHECK(gcode.find("\nDISABLE_BOX_HEATER\n") < command);
+        CHECK(command < gcode.find("\n;QIDI_TEST_START\n"));
+        CHECK(gcode.find("\nBOX_TEMP_SET VT0=") == std::string::npos);
+    } else {
+        CHECK(gcode.find("\nBOX_TEMP_SET ") == std::string::npos);
+        CHECK(gcode.find("\nDISABLE_BOX_HEATER\n") == std::string::npos);
+    }
+}
