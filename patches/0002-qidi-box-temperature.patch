 }
+
+TEST_CASE("QIDI Box settings survive a preset save and reload", "[Config][QidiBox]")
+{
+    ScopedTemporaryFile tmp(".json");
+    DynamicPrintConfig config = DynamicPrintConfig::full_print_config();
+    config.set_deserialize_strict({
+        {"support_box_temp_control", true},
+        {"box_temperature", "0,45"},
+        {"box_temperature_range_low", "0,35"},
+        {"box_temperature_range_high", "35,55"},
+    });
+    config.save_to_json(tmp.string(), "QIDI Box test", "User", "1.0.0.0");
+    DynamicPrintConfig loaded;
+    ConfigSubstitutionContext substitutions(ForwardCompatibilitySubstitutionRule::Disable);
+    std::map<std::string, std::string> metadata;
+    std::string reason;
+    REQUIRE(loaded.load_from_json(tmp.string(), substitutions, true, metadata, reason) == 0);
+    CHECK(reason.empty());
+    CHECK(loaded.opt_bool("support_box_temp_control"));
+    CHECK(loaded.option<ConfigOptionInts>("box_temperature")->values == std::vector<int>{0, 45});
+    CHECK(loaded.option<ConfigOptionInts>("box_temperature_range_low")->values == std::vector<int>{0, 35});
+    CHECK(loaded.option<ConfigOptionInts>("box_temperature_range_high")->values == std::vector<int>{35, 55});
+}
