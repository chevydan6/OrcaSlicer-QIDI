From b0a9786c1e7432e6e9ce838bdd208d157899c9a9 Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:44:08 +0900
Subject: [PATCH] Set a layout-derived minimum for QIDI material dialogs

---
 src/slic3r/GUI/AMSMaterialsSetting.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/slic3r/GUI/AMSMaterialsSetting.cpp b/src/slic3r/GUI/AMSMaterialsSetting.cpp
index b975b3ea..cd15bddb 100644
--- a/src/slic3r/GUI/AMSMaterialsSetting.cpp
+++ b/src/slic3r/GUI/AMSMaterialsSetting.cpp
@@ -1191,7 +1191,16 @@ bool AMSMaterialsSetting::Show(bool show)
         m_k_param->Show();
         m_input_k_val->Show();
         Layout();
-        Fit();
+        if (qidi) {
+            // Fit() alone leaves GTK free to shrink this fixed-size dialog
+            // while the window manager updates its decorations. Keep the
+            // minimum tied to the current slot's contents, including buttons.
+            SetMinSize(wxDefaultSize);
+            SetMaxSize(wxDefaultSize);
+            GetSizer()->SetSizeHints(this);
+        } else {
+            Fit();
+        }
         wxGetApp().UpdateDlgDarkUI(this);
     }
     return DPIDialog::Show(show);
-- 
