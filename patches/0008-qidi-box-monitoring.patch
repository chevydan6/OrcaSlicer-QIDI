+void QidiPrinterAgent::append_box_status(const nlohmann::json& status, nlohmann::json& payload)
+{
+    const auto controller = status.find("multi_color_controller");
+    if (controller == status.end() || !controller->is_object())
+        return;
+    const auto nested = controller->find("box");
+    const auto& box = nested != controller->end() && nested->is_object() ? *nested : *controller;
+    const auto count_in = [](const nlohmann::json& object) -> std::optional<int> {
+        const auto count = object.find("box_count");
+        if (count == object.end() || !count->is_number_integer() || *count < 0 || *count > 4)
+            return std::nullopt;
+        return count->get<int>();
+    };
+    auto count = count_in(*controller);
+    if (!count)
+        count = count_in(box);
+    if (!count && status.contains("save_variables") && status["save_variables"].is_object()) {
+        const auto variables = status["save_variables"].find("variables");
+        if (variables != status["save_variables"].end() && variables->is_object())
+            count = count_in(*variables);
+    }
+    // The AMS parser treats this as a complete unit list, so never infer count
+    // from a partial temperature update and accidentally remove other Boxes.
+    if (!count)
+        return;
+    nlohmann::json units = nlohmann::json::array();
+    for (int i = 0; i < *count; ++i) {
+        const auto prefix = "box" + std::to_string(i) + "_";
+        nlohmann::json unit{{"id", std::to_string(i)}, {"info", "0003"},
+                            {"display_name", "Qidi Box " + std::to_string(i + 1)}};
+        const auto temperature = box.find(prefix + "aht20_temp");
+        if (temperature != box.end() && temperature->is_number() && *temperature >= -40 && *temperature <= 125)
+            unit["temp"] = temperature->dump();
+        const auto humidity = box.find(prefix + "aht20_humidity");
+        if (humidity != box.end() && humidity->is_number() && *humidity >= 0 && *humidity <= 100)
+            unit["humidity_raw"] = std::to_string(humidity->get<int>());
+        // No tray key: telemetry must preserve synchronized filament metadata.
+        units.push_back(std::move(unit));
+    }
+    std::ostringstream bits;
+    bits << std::hex << ((1U << *count) - 1U);
+    payload["print"]["ams"]["ams"] = std::move(units);
+    payload["print"]["ams"]["ams_exist_bits"] = bits.str();
+}
