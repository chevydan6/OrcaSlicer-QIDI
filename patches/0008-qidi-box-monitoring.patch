+    std::string ams_unit_info() const override { return "0003"; }
 
 private:
     bool set_timelapse_enabled(bool enabled) const;
diff --git a/tests/slic3rutils/test_qidi_printer_agent.cpp b/tests/slic3rutils/test_qidi_printer_agent.cpp
index 9c5dd774..44f249e4 100644
--- a/tests/slic3rutils/test_qidi_printer_agent.cpp
+++ b/tests/slic3rutils/test_qidi_printer_agent.cpp
@@ -105,3 +105,31 @@ TEST_CASE("QIDI load and unload address the selected physical slot", "[QidiPrint
     CHECK(script == (target == 255 ? "UNLOAD_FILAMENT_CONTROL SLOT=6" : "LOAD_FILAMENT_CONTROL SLOT=6"));
     CHECK_THROWS(QidiPrinterAgent::control_script({{"command", "ams_change_filament"}, {"ams_id", 1}, {"slot_id", 255}, {"target", 255}}));
 }
+
+TEST_CASE("QIDI Box telemetry preserves the complete unit list without replacing trays", "[QidiPrinterAgent]")
+{
+    nlohmann::json payload;
+    const nlohmann::json box{{"box0_aht20_temp", 23.5}, {"box0_aht20_humidity", 35},
+                            {"box1_aht20_temp", 45}, {"box1_aht20_humidity", 10}};
+    const bool nested = GENERATE(false, true);
+    nlohmann::json status{{"save_variables", {{"variables", {{"box_count", 2}}}}},
+                          {"multi_color_controller", nested ? nlohmann::json{{"box", box}} : box}};
+    QidiPrinterAgent::append_box_status(status, payload);
+    const auto& ams = payload["print"]["ams"];
+    CHECK(ams["ams_exist_bits"] == "3");
+    REQUIRE(ams["ams"].size() == 2);
+    CHECK(ams["ams"][0]["temp"] == "23.5");
+    CHECK(ams["ams"][1]["humidity_raw"] == "10");
+    CHECK(ams["ams"][1]["id"] == "1");
+    CHECK_FALSE(ams["ams"][0].contains("tray"));
+    CHECK_FALSE(ams["ams"][1].contains("tray"));
+}
+
+TEST_CASE("QIDI Box telemetry requires a valid known box count", "[QidiPrinterAgent]")
+{
+    nlohmann::json payload = nlohmann::json::object();
+    const auto count = GENERATE(nlohmann::json(nullptr), nlohmann::json(5), nlohmann::json(-1),
+                               nlohmann::json(4294967296ULL), nlohmann::json("2"));
+    QidiPrinterAgent::append_box_status({{"multi_color_controller", {{"box_count", count}}}}, payload);
+    CHECK(payload.empty());
+}
