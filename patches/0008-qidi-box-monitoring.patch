     static void append_chamber_status(const nlohmann::json& status, nlohmann::json& payload);
+    static void append_box_status(const nlohmann::json& status, nlohmann::json& payload);
     static AgentInfo get_agent_info_static();
     AgentInfo        get_agent_info() override { return get_agent_info_static(); }
 
@@ -39,12 +40,16 @@ public:
     static nlohmann::json print_start_request(const PrintParams& params, const std::string& filename);
 
 protected:
-    std::vector<std::string> additional_status_objects() const override { return {"heater_generic chamber"}; }
+    std::vector<std::string> additional_status_objects() const override
