From 2913e8635a60309ef9585794d717faae7d1e4a3b Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:50:31 +0900
Subject: [PATCH] Preserve upstream G-code import with the downstream
 application identity

---
 src/libslic3r/Config.cpp                       | 3 +++
 tests/libslic3r/test_preset_bundle_loading.cpp | 4 +++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/libslic3r/Config.cpp b/src/libslic3r/Config.cpp
index 3e71ee8a..8caeca79 100644
--- a/src/libslic3r/Config.cpp
+++ b/src/libslic3r/Config.cpp
@@ -1418,6 +1418,8 @@ ConfigSubstitutions ConfigBase::load_from_gcode_file(const std::string &file, Fo
 
         std::string orcaslicer_gcode_header = std::string("; generated by ");
         orcaslicer_gcode_header += SLIC3R_APP_NAME;
+        // The downstream application name must not exclude existing upstream files.
+        const std::string upstream_gcode_header = "; generated by OrcaSlicer";
 
         std::string header;
         bool        header_found = false;
@@ -1429,6 +1431,7 @@ ConfigSubstitutions ConfigBase::load_from_gcode_file(const std::string &file, Fo
             line_c = skip_whitespaces(line_c);
             // BBS
             if (strncmp(bambuslicer_gcode_header.c_str(), line_c, strlen(bambuslicer_gcode_header.c_str())) == 0 ||
+                strncmp(upstream_gcode_header.c_str(), line_c, upstream_gcode_header.size()) == 0 ||
                 strncmp(orcaslicer_gcode_header.c_str(), line_c, strlen(orcaslicer_gcode_header.c_str())) == 0) {
                 header_found = true;
                 break;
diff --git a/tests/libslic3r/test_preset_bundle_loading.cpp b/tests/libslic3r/test_preset_bundle_loading.cpp
index 9e84add9..888dbf33 100644
--- a/tests/libslic3r/test_preset_bundle_loading.cpp
+++ b/tests/libslic3r/test_preset_bundle_loading.cpp
@@ -9058,13 +9058,15 @@ TEST_CASE("Selections reach the app config only while no export blocker lives",
 
 TEST_CASE("An empty choice list in a G-code's settings keeps the value it had before the file was read", "[Preset][Bundle]")
 {
+    const auto header = GENERATE("; generated by OrcaSlicer", "; generated by OrcaSlicer QIDI", "; OrcaSlicer");
+    CAPTURE(header);
     // A G-code written by a tool rather than from presets can leave nozzle_volume_type empty, and the settings
     // tabs index it per extruder. A blank text list is a value of its own and stays blank.
     const DynamicPrintConfig block = DynamicPrintConfig::full_print_config();
     ScopedTemporaryFile      file(".gcode");
     {
         std::ofstream os(file.string());
-        os << "; generated by OrcaSlicer\n; CONFIG_BLOCK_START\n";
+        os << header << "\n; CONFIG_BLOCK_START\n";
         for (const std::string &key : block.keys())
             if (key != "nozzle_volume_type" && key != "filament_multi_colour")
                 os << "; " << key << " = " << block.opt_serialize(key) << '\n';
