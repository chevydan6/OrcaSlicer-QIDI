+TEST_CASE("QIDI HTTP submission orders setup before the selected plate and stops on errors", "[QidiPrinterAgent][Http]")
+{
+    const std::size_t fail_at = GENERATE(0U, 1U, 2U, 3U, 4U, 5U);
+    QidiHttpFixture printer(fail_at);
+    QidiPrinterAgent agent("");
+    QidiPrinterAgentTestAccess::endpoint(agent, printer.url());
+    PrintParams params{};
+    params.plate_index = 2;
+    params.task_use_ams = true;
+    params.ams_mapping = "[-1,-1,5]";
+    params.task_bed_leveling = true;
+    params.task_record_timelapse = true;
+    params.extra_options = R"({"qidi":{"is_support_multi_box":true,"qidi_preprint_bed_leveling":true,"is_support_timelapse":true,"polar_cooler":false}})";
+    CHECK(QidiPrinterAgentTestAccess::submit(agent, params) == (fail_at == 0));
+    const auto requests = printer.requests();
+    REQUIRE(requests.size() == (fail_at == 0 ? 5 : fail_at));
+    for (const auto& request : requests)
+        CHECK(request.api_key == "fixture-key");
+    CHECK(requests[0].path == "/printer/gcode/script");
+    CHECK(nlohmann::json::parse(requests[0].body)["script"] ==
+          "SAVE_VARIABLE VARIABLE=enable_box VALUE=1\nSAVE_VARIABLE VARIABLE=value_t2 VALUE=\"'slot5'\"");
+    if (requests.size() > 1)
+        CHECK(nlohmann::json::parse(requests[1].body)["script"] == "G31");
+    if (requests.size() > 2)
+        CHECK(requests[2].path == "/machine/timelapse/settings?enabled=true");
+    if (requests.size() > 3)
+        CHECK(nlohmann::json::parse(requests[3].body)["script"] == "SAVE_VARIABLE VARIABLE=enable_polar_cooler VALUE=0");
+    if (requests.size() > 4) {
+        CHECK(requests[4].path == "/printer/print/start");
+        CHECK(nlohmann::json::parse(requests[4].body) == nlohmann::json{{"filename", "two plates.gcode.3mf"}, {"plateindex", "2"}});
+    }
+}
+
+TEST_CASE("QIDI HTTP upload stages the file without requesting an automatic print", "[QidiPrinterAgent][Http]")
+{
+    const std::size_t fail_at = GENERATE(0U, 1U);
+    QidiHttpFixture printer(fail_at);
+    QidiPrinterAgent agent("");
+    QidiPrinterAgentTestAccess::endpoint(agent, printer.url());
+    ScopedTemporaryFile file(".gcode");
+    {
+        boost::filesystem::ofstream stream(file.path());
+        stream << "; offline transport fixture\n";
+    }
+    CHECK(QidiPrinterAgentTestAccess::upload(agent, file.string()) == (fail_at == 0));
+    const auto requests = printer.requests();
+    REQUIRE(requests.size() == 1);
+    CHECK(requests[0].path == "/server/files/upload");
+    CHECK(requests[0].api_key == "fixture-key");
+    CHECK(requests[0].body.find("name=\"print\"\r\n\r\nfalse") != std::string::npos);
+    CHECK(requests[0].body.find("; offline transport fixture") != std::string::npos);
+}
