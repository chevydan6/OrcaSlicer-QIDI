+namespace {
+namespace net = boost::asio;
+namespace http = boost::beast::http;
+using tcp = net::ip::tcp;
+
+// Async loopback-only HTTP server: no real printer discovery, connection or commands.
+class QidiHttpFixture
+{
+public:
+    struct Request { std::string path, body, api_key; };
+    explicit QidiHttpFixture(std::size_t fail_at) : m_fail_at(fail_at)
+    {
+        accept();
+        m_thread = std::thread([this] { m_io.run(); });
+    }
+    ~QidiHttpFixture() { m_io.stop(); m_thread.join(); }
+    std::string url() const { return "http://127.0.0.1:" + std::to_string(m_acceptor.local_endpoint().port()); }
+    std::vector<Request> requests() { std::lock_guard<std::mutex> lock(m_mutex); return m_requests; }
+private:
+    struct Session {
+        explicit Session(tcp::socket stream) : socket(std::move(stream)) {}
+        tcp::socket socket;
+        boost::beast::flat_buffer buffer;
+        http::request<http::string_body> request;
+        http::response<http::string_body> response;
+    };
+    void accept()
+    {
+        m_acceptor.async_accept([this](boost::beast::error_code error, tcp::socket socket) {
+            if (error) return;
+            auto session = std::make_shared<Session>(std::move(socket));
+            http::async_read(session->socket, session->buffer, session->request,
+                [this, session](boost::beast::error_code error, std::size_t) {
+                    if (error) return;
+                    bool fail;
+                    {
+                        std::lock_guard<std::mutex> lock(m_mutex);
+                        m_requests.push_back({std::string(session->request.target()), session->request.body(),
+                                              std::string(session->request["X-Api-Key"])});
+                        fail = m_requests.size() == m_fail_at;
+                    }
+                    session->response = {fail ? http::status::internal_server_error : http::status::ok, 11};
+                    session->response.body() = fail ? "{\"error\":\"fixture failure\"}" : "{\"result\":\"ok\"}";
+                    session->response.prepare_payload();
+                    http::async_write(session->socket, session->response,
+                        [session](boost::beast::error_code, std::size_t) {});
+                });
+            accept();
+        });
+    }
+    net::io_context m_io;
+    tcp::acceptor m_acceptor{m_io, {net::ip::make_address("127.0.0.1"), 0}};
+    std::size_t m_fail_at;
+    std::mutex m_mutex;
+    std::vector<Request> m_requests;
+    std::thread m_thread;
+};
+}
