-                 DevPrinterConfigUtil::get_printer_display_name(obj->printer_type), nozzle_diameter_str, obj->is_support_user_preset)) {
+                 obj->printer_agent_id == "qidi" ? std::string(obj->get_printer_type_display_str().utf8_str())
+                                                 : DevPrinterConfigUtil::get_printer_display_name(obj->printer_type),
+                 nozzle_diameter_str, obj->printer_agent_id == "qidi" || obj->is_support_user_preset)) {
             if (!filament_id_set.insert(filament_it->filament_id).second)
                 continue;
             const std::string alias = preset_bundle->filaments.get_preset_alias(*filament_it, true);
@@ -1419,7 +1434,7 @@ void AMSMaterialsSetting::Popup(wxString filament, wxString sn, wxString temp_mi
             m_input_k_val->Enable();
         }
 
-        m_button_reset->Show();
+        m_button_reset->Show(obj->printer_agent_id != "qidi");
