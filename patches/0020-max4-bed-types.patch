diff --git a/src/slic3r/GUI/PlateSettingsDialog.cpp b/src/slic3r/GUI/PlateSettingsDialog.cpp
index 31b83677..8fd87954 100644
--- a/src/slic3r/GUI/PlateSettingsDialog.cpp
+++ b/src/slic3r/GUI/PlateSettingsDialog.cpp
@@ -418,7 +418,10 @@ PlateSettingsDialog::PlateSettingsDialog(wxWindow* parent, const wxString& title
         int                    index        = 0;
         for (auto item : bed_type_def->enum_labels) {
             index++;
-            bool find = std::find(pm->not_support_bed_types.begin(), pm->not_support_bed_types.end(), item) != pm->not_support_bed_types.end();
+            // QIDI stores canonical enum values; retain support for older label-based profiles.
+            const auto& value = bed_type_def->enum_values[index - 1];
+            bool find = std::find(pm->not_support_bed_types.begin(), pm->not_support_bed_types.end(), value) != pm->not_support_bed_types.end() ||
+                        std::find(pm->not_support_bed_types.begin(), pm->not_support_bed_types.end(), item) != pm->not_support_bed_types.end();
