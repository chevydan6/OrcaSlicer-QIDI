     CHECK(legacy->serialize() == "0x0,10x0,10x10,0x10");
 }
 
+TEST_CASE("QIDI projects preserve object and filament assignments", "[3mf][Qidi][Regression]")
+{
+    using namespace Slic3r;
+    ScopedSlic3rTemporaryDir temporary_dir("orca_qidi_import");
+    const std::string path = std::string(TEST_DATA_DIR) + "/test_3mf/qidi_max4_sparse.3mf";
+    Model model;
+    DynamicPrintConfig config;
+    ConfigSubstitutionContext substitutions{ForwardCompatibilitySubstitutionRule::Enable};
+    PlateDataPtrs plates;
+    std::vector<Preset*> presets;
+    bool structured = false, orca = false;
+    Semver version;
+    const bool loaded = load_bbs_3mf(path.c_str(), &config, &substitutions, &model, &plates,
+        &presets, &structured, &orca, &version, nullptr, LoadStrategy::LoadModel | LoadStrategy::LoadConfig);
+    release_PlateData_list(plates);
+    for (auto* preset : presets) delete preset;
+    REQUIRE(loaded);
+    CHECK(structured);
+    CHECK_FALSE(orca);
+    CHECK(version == Semver(2, 0, 0));
+    REQUIRE(model.objects.size() == 1);
+    REQUIRE(model.objects.front()->volumes.size() == 1);
+    REQUIRE(model.objects.front()->instances.size() == 1);
+    CHECK(model.objects.front()->volumes.front()->mesh().facets_count() == 12);
+    const auto* extruder = model.objects.front()->config.option<ConfigOptionInt>("extruder");
+    REQUIRE(extruder != nullptr);
+    CHECK(extruder->value == 3);
+    const auto* colours = config.option<ConfigOptionStrings>("filament_colour");
+    REQUIRE(colours != nullptr);
+    CHECK(colours->values.size() == 3);
+    const auto* temperatures = config.option<ConfigOptionInts>("box_temperature");
+    REQUIRE(temperatures != nullptr);
+    CHECK(temperatures->values == std::vector<int>{35, 40, 45});
+    const auto* expansion = config.option<ConfigOptionFloat>("raft_first_layer_expansion");
+    REQUIRE(expansion != nullptr);
+    CHECK_THAT(expansion->value, Catch::Matchers::WithinAbs(2.0, 1e-9));
+    const auto* compatible = config.option<ConfigOptionStrings>("print_compatible_printers");
+    REQUIRE(compatible != nullptr);
+    CHECK(compatible->values == std::vector<std::string>{"Qidi X-Max 4 0.4 nozzle"});
+}
