From 5961d34850db8ad962fe188fd8bfe8d47744433c Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:45:21 +0900
Subject: [PATCH] Import QIDI structured projects with MAX4 compatibility
 migration

---
 src/libslic3r/Format/bbs_3mf.cpp              |  38 +++++++++++++++-
 tests/data/test_3mf/qidi_max4_sparse.3mf      | Bin 0 -> 24672 bytes
 .../data/test_3mf/qidi_max4_sparse.README.md  |  14 ++++++
 tests/libslic3r/test_3mf.cpp                  |  41 ++++++++++++++++++
 4 files changed, 92 insertions(+), 1 deletion(-)
 create mode 100644 tests/data/test_3mf/qidi_max4_sparse.3mf
 create mode 100644 tests/data/test_3mf/qidi_max4_sparse.README.md

diff --git a/src/libslic3r/Format/bbs_3mf.cpp b/src/libslic3r/Format/bbs_3mf.cpp
index d00349fb..a4599948 100644
--- a/src/libslic3r/Format/bbs_3mf.cpp
+++ b/src/libslic3r/Format/bbs_3mf.cpp
@@ -41,6 +41,7 @@
 #include <boost/optional/optional.hpp>
 #include <istream>
 #include <functional>
+#include <initializer_list>
 #include <boost/algorithm/string/find.hpp>
 #include <cstdio>
 #include <exception>
@@ -1237,6 +1238,7 @@ void PlateData::parse_filament_info(GCodeProcessorResult *result)
 
         //BBS: plater related structures
         bool m_is_bbl_3mf { false };
+        bool m_is_qidi_3mf { false };
         bool m_parsing_slice_info { false };
         PlateDataMaps m_plater_data;
         PlateData* m_curr_plater;
@@ -2810,6 +2812,28 @@ void PlateData::parse_filament_info(GCodeProcessorResult *result)
             }
             BOOST_LOG_TRIVIAL(info) << __FUNCTION__ << boost::format(", load project config file successfully from %1%\n") %dest_file;
 
+            if (m_is_qidi_3mf) {
+                // QIDI's auto expansion resolves to 2 mm in both raft and
+                // ordinary support generation (SupportCommon.cpp).
+                if (auto* expansion = config.option<ConfigOptionFloat>("raft_first_layer_expansion");
+                    expansion && expansion->value == -1.0)
+                    expansion->value = 2.0;
+                // The same MAX4 profiles have a vendor prefix in Orca. Keep
+                // compatibility checks enabled when replacing the machine.
+                for (const char* key : {"print_compatible_printers", "compatible_printers"}) {
+                    if (auto* printers = config.option<ConfigOptionStrings>(key)) {
+                        for (auto& printer : printers->values) {
+                            for (const char* nozzle : {"0.2", "0.4", "0.6", "0.8"}) {
+                                if (printer == std::string("X-Max 4 ") + nozzle + " nozzle") {
+                                    printer = "Qidi " + printer;
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
             // Heal any gradient-curve slots corrupted by the legacy "|" separator collision
             // (see FilamentMixer::sanitize_mixed_gradient_curve_array). The 3MF JSON itself
             // is safe (";" + C-style escape), but older projects saved through the buggy
@@ -4159,7 +4183,8 @@ void PlateData::parse_filament_info(GCodeProcessorResult *result)
 
     bool _BBS_3MF_Importer::_handle_end_metadata()
     {
-        if ((m_curr_metadata_name == BBS_3MF_VERSION)||(m_curr_metadata_name == BBS_3MF_VERSION1)) {
+        if ((m_curr_metadata_name == BBS_3MF_VERSION)||(m_curr_metadata_name == BBS_3MF_VERSION1) ||
+            m_curr_metadata_name == "QIDIStudio:3mfVersion") {
             //m_is_bbl_3mf = true;
             m_version = (unsigned int)atoi(m_curr_characters.c_str());
             /*if (m_check_version && (m_version > VERSION_BBS_3MF_COMPATIBLE)) {
@@ -4179,6 +4204,17 @@ void PlateData::parse_filament_info(GCodeProcessorResult *result)
                 m_is_bbl_3mf = true;
                 m_bambuslicer_generator_version = Semver::parse(m_curr_characters.substr(11));
             }
+            else if (boost::starts_with(m_curr_characters, "QIDIStudio-")) {
+                // QIDI retains the structured Bambu project format, including
+                // object/material assignments. Its product version is not an
+                // Orca or Bambu format version and must not drive that migration.
+                m_is_bbl_3mf = true;
+                m_is_qidi_3mf = true;
+                // Use the compatible project-schema baseline, not QIDI's
+                // four-part product version. A missing version would invoke
+                // pre-1.5.9 plate-origin translation and shift modern projects.
+                m_bambuslicer_generator_version = Semver(2, 0, 0);
+            }
         } else if (m_curr_metadata_name == ORCASLICER_TAG) {
             // OrcaSlicer version tag (written from OrcaSlicer 2.3.2 onwards)
             m_orca_slicer_version = Semver::parse(m_curr_characters);
