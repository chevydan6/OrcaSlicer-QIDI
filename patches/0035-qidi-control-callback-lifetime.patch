diff --git a/src/slic3r/Utils/MoonrakerPrinterAgent.cpp b/src/slic3r/Utils/MoonrakerPrinterAgent.cpp
index f7d025f8..21c7aabd 100644
--- a/src/slic3r/Utils/MoonrakerPrinterAgent.cpp
+++ b/src/slic3r/Utils/MoonrakerPrinterAgent.cpp
@@ -283,6 +283,7 @@ MoonrakerPrinterAgent::MoonrakerPrinterAgent(std::string log_dir) : m_cloud_agen
 
 MoonrakerPrinterAgent::~MoonrakerPrinterAgent()
 {
+    callbacks_alive->store(false);
     {
         std::lock_guard<std::recursive_mutex> lock(connect_mutex);
         device_info = MoonrakerDeviceInfo{};
@@ -1249,9 +1250,10 @@ int MoonrakerPrinterAgent::handle_request(const std::string& dev_id, const std::
             }
             response["print"]["param"] = gcode;
 
-            send_gcode_async(dev_id, gcode, [this, dev_id, response](bool success) mutable {
+            const auto dispatch = message_dispatcher(dev_id);
+            send_gcode_async(dev_id, gcode, [dispatch, response](bool success) mutable {
                 response["print"]["result"] = success ? "success" : "failed";
-                dispatch_message(dev_id, response.dump());
+                dispatch(response.dump());
             });
             return BAMBU_NETWORK_SUCCESS;
         }
@@ -2315,6 +2317,11 @@ nlohmann::json MoonrakerPrinterAgent::build_print_payload_locked() const
 }
 
 void MoonrakerPrinterAgent::dispatch_message(const std::string& dev_id, const std::string& payload)
+{
+    message_dispatcher(dev_id)(payload);
+}
+
+std::function<void(const std::string&)> MoonrakerPrinterAgent::message_dispatcher(const std::string& dev_id) const
 {
     OnMessageFn   local_fn;
     OnMessageFn   cloud_fn;
@@ -2326,26 +2333,24 @@ void MoonrakerPrinterAgent::dispatch_message(const std::string& dev_id, const st
         queue_fn = queue_on_main_fn;
     }
 
-    if (!local_fn && !cloud_fn) {
-        BOOST_LOG_TRIVIAL(warning) << "MoonrakerPrinterAgent: dispatch_message - no message callback registered!";
-        return;
-    }
-
-    auto dispatch = [dev_id, payload, local_fn, cloud_fn]() {
-        if (local_fn) {
-            local_fn(dev_id, payload);
+    const auto alive = callbacks_alive;
+    return [dev_id, local_fn, cloud_fn, queue_fn, alive](const std::string& payload) {
+        if (!alive->load()) return;
+        if (!local_fn && !cloud_fn) {
+            BOOST_LOG_TRIVIAL(warning) << "MoonrakerPrinterAgent: dispatch_message - no message callback registered!";
             return;
         }
-        if (cloud_fn) {
-            cloud_fn(dev_id, payload);
+        auto dispatch = [dev_id, payload, local_fn, cloud_fn, alive]() {
+            if (!alive->load()) return;
+            if (local_fn) local_fn(dev_id, payload);
+            else if (cloud_fn) cloud_fn(dev_id, payload);
+        };
+        if (queue_fn) {
+            queue_fn(dispatch);
+        } else {
+            dispatch();
         }
     };
-
-    if (queue_fn) {
-        queue_fn(dispatch);
-    } else {
-        dispatch();
-    }
 }
 
 bool MoonrakerPrinterAgent::upload_gcode(const std::string& local_path,
diff --git a/src/slic3r/Utils/MoonrakerPrinterAgent.hpp b/src/slic3r/Utils/MoonrakerPrinterAgent.hpp
