 #include <boost/asio/io_context.hpp>
 #include <boost/asio/ip/address.hpp>
 #include <boost/asio/ip/tcp.hpp>
@@ -63,11 +64,37 @@ struct QidiPrinterAgentTestAccess
     }
     static bool submit(QidiPrinterAgent& agent, const PrintParams& params)
     { return agent.print_uploaded_file(params, "two plates.gcode.3mf"); }
+    static std::function<void(const std::string&)> dispatcher(QidiPrinterAgent& agent)
+    { return agent.message_dispatcher("offline-fixture"); }
     static bool upload(QidiPrinterAgent& agent, const std::string& path)
     { return agent.upload_gcode(path, "offline cube.gcode", agent.device_info.base_url, agent.device_info.api_key, {}, {}); }
 };
 }
 
+TEST_CASE("QIDI delayed responses stop dispatching when the agent is destroyed", "[QidiPrinterAgent][Regression]")
+{
+    int received = 0;
+    std::vector<std::function<void()>> queued;
+    auto agent = std::make_unique<QidiPrinterAgent>("");
+    agent->set_on_local_message_fn([&](std::string, std::string) { ++received; });
+    agent->set_queue_on_main_fn([&](std::function<void()> callback) { queued.push_back(std::move(callback)); });
+    auto delayed_response = QidiPrinterAgentTestAccess::dispatcher(*agent);
+    delayed_response("first");
+    REQUIRE(queued.size() == 1);
+    queued.front()();
+    CHECK(received == 1);
+    queued.clear();
+    delayed_response("queued before destruction");
+    REQUIRE(queued.size() == 1);
+    agent.reset();
+    queued.front()();
+    CHECK(received == 1);
+    queued.clear();
+    CHECK_NOTHROW(delayed_response("HTTP completed after destruction"));
+    CHECK(queued.empty());
+    CHECK(received == 1);
+}
+
 namespace {
 namespace net = boost::asio;
 namespace http = boost::beast::http;
