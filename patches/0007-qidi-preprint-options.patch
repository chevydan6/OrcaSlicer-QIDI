 {
     const auto* bundle = GUI::wxGetApp().preset_bundle;
-    const auto* support = bundle ? bundle->printers.get_edited_preset().config.option<ConfigOptionBool>("is_support_multi_box") : nullptr;
-    const bool has_box_support = support && support->value;
+    const auto supported = [&](const char* key) {
+        const auto* option = bundle ? bundle->printers.get_edited_preset().config.option<ConfigOptionBool>(key) : nullptr;
+        return option && option->value;
+    };
+    const bool has_box_support = supported("is_support_multi_box");
     const std::string script = has_box_support ? build_box_selection_script(params) : build_tool_slot_script(params.ams_mapping);
     if (has_box_support && params.task_use_ams && script.empty())
         return false;
     if (!script.empty() && !send_gcode_sync(device_info.dev_id, script)) {
         return false;
     }
+    // QIDI Studio applies these choices before starting the uploaded job.
+    if (supported("qidi_preprint_bed_leveling") &&
+        !send_gcode_sync(device_info.dev_id, params.task_bed_leveling ? "G31" : "G32"))
+        return false;
+    if (supported("is_support_timelapse") && !set_timelapse_enabled(params.task_record_timelapse))
+        return false;
 
     // On the X-Max 4 and Q2, Klipper only opens the copy Moonraker's print start makes, so SDCARD_PRINT_FILE can't find the upload
     std::string response;
     return send_jsonrpc_command(device_info.base_url, device_info.api_key, print_start_request(params, filename), response);
 }
 
+bool QidiPrinterAgent::set_timelapse_enabled(bool enabled) const
+{
+    auto http = Http::post(join_url(device_info.base_url,
+        std::string("/machine/timelapse/settings?enabled=") + (enabled ? "true" : "false")));
+    if (!device_info.api_key.empty())
+        http.header("X-Api-Key", device_info.api_key);
+    bool success = false;
+    http.header("Content-Type", "application/json")
+        .set_post_body("{}")
+        .timeout_connect(5)
+        .timeout_max(10)
+        .on_complete([&](std::string, unsigned status) { success = status >= 200 && status < 300; })
+        .on_error([](std::string, std::string error, unsigned status) {
+            BOOST_LOG_TRIVIAL(error) << "QIDI timelapse setting failed: " << error << " (HTTP " << status << ")";
+        })
+        .perform_sync();
+    return success;
+}
