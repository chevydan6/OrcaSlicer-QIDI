     bool is_support_filament_setting_inprinting{false};
     bool is_support_internal_timelapse { false };// fun[28], support timelapse without SD card
     bool qidi_polar_cooler_available { false };
+    std::optional<bool> qidi_polar_cooler_on;
     bool m_support_mqtt_homing { false };// fun[32]
     bool is_support_brtc{false};                 // fun[31], support tcp and upload protocol
     bool is_support_ext_change_assist{false};
diff --git a/src/slic3r/GUI/PrintOptionsDialog.cpp b/src/slic3r/GUI/PrintOptionsDialog.cpp
index 571ec011..a9e87ed0 100644
--- a/src/slic3r/GUI/PrintOptionsDialog.cpp
+++ b/src/slic3r/GUI/PrintOptionsDialog.cpp
@@ -4,6 +4,9 @@
 #include <ctime>
 #include <cassert>
 #include <initializer_list>
+#include <nlohmann/json.hpp>
+#include "Widgets/CheckBox.hpp"
+#include "Widgets/Label.hpp"
 #include <wx/colour.h>
 #include "slic3r/GUI/Widgets/StateColor.hpp"
 #include <utility>
@@ -79,6 +82,16 @@ PrintOptionsDialog::PrintOptionsDialog(wxWindow* parent)
     mainSizer->Fit(this);
     //this->Fit();
 
+    m_cb_qidi_polar_cooler->Bind(wxEVT_TOGGLEBUTTON, [this](wxCommandEvent& evt) {
+        if (obj && obj->printer_agent_id == "qidi" && obj->qidi_polar_cooler_available && obj->qidi_polar_cooler_on.has_value()) {
+            const nlohmann::json request{{"print", {{"command", "qidi_polar_cooler"},
+                {"enabled", m_cb_qidi_polar_cooler->GetValue()},
+                {"sequence_id", std::to_string(MachineObject::m_sequence_id++)}}}};
+            obj->publish_json(request);
+        }
+        evt.Skip();
+    });
+
      m_cb_ai_monitoring->Bind(wxEVT_TOGGLEBUTTON, [this](wxCommandEvent &evt) {
         if (obj) {
             int         level = ai_monitoring_level_list->GetSelection();
@@ -368,6 +381,11 @@ void PrintOptionsDialog::update_options(MachineObject* obj_)
 {
     if (!obj_) return;
 
+    const bool show_cooler = obj_->printer_agent_id == "qidi" && obj_->qidi_polar_cooler_available && obj_->qidi_polar_cooler_on.has_value();
+    m_qidi_polar_cooler_sizer->Show(show_cooler);
+    if (show_cooler)
+        m_cb_qidi_polar_cooler->SetValue(*obj_->qidi_polar_cooler_on);
+
     if (obj_->is_support_spaghetti_detection || obj_->is_support_purgechutepileup_detection || obj_->is_support_nozzleclumping_detection || obj_->is_support_airprinting_detection) {
         ai_refine_panel->Show();
         text_ai_detections->Show();
@@ -819,6 +837,16 @@ wxBoxSizer* PrintOptionsDialog::create_settings_group(wxWindow* parent)
     wxBoxSizer* sizer = new wxBoxSizer(wxVERTICAL);
     wxBoxSizer* line_sizer = new wxBoxSizer(wxHORIZONTAL);
 
+    m_qidi_polar_cooler_sizer = new wxBoxSizer(wxHORIZONTAL);
+    m_cb_qidi_polar_cooler = new CheckBox(parent);
+    auto* cooler_label = new Label(parent, _L("Polar Cooler"));
+    cooler_label->SetFont(Label::Body_14);
+    m_cb_qidi_polar_cooler->SetToolTip(_L("Turn the extruder cooler on or off."));
+    m_qidi_polar_cooler_sizer->Add(m_cb_qidi_polar_cooler, 0, wxALL | wxALIGN_CENTER_VERTICAL, FromDIP(5));
+    m_qidi_polar_cooler_sizer->Add(cooler_label, 1, wxALL | wxALIGN_CENTER_VERTICAL, FromDIP(5));
+    sizer->Add(m_qidi_polar_cooler_sizer, 0, wxEXPAND | wxLEFT | wxRIGHT, FromDIP(18));
+    m_qidi_polar_cooler_sizer->Show(false);
+
   /*  auto m_line = new wxPanel(this, wxID_ANY, wxDefaultPosition, wxSize(-1, 1), wxTAB_TRAVERSAL);
     m_line->SetBackgroundColour(wxColour(166, 169, 170));
     sizer->Add(m_line, 0, wxEXPAND, 0);*/
