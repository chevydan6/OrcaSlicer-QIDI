From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 07:37:33 +0900
Subject: [PATCH] Add reported Polar Cooler control to QIDI print options

---
 src/slic3r/GUI/DeviceManager.cpp              |  2 ++
 src/slic3r/GUI/DeviceManager.hpp              |  1 +
 src/slic3r/GUI/PrintOptionsDialog.cpp         | 28 +++++++++++++++++++
 src/slic3r/GUI/PrintOptionsDialog.hpp         |  2 ++
 src/slic3r/Utils/QidiPrinterAgent.cpp         | 12 ++++++++
 src/slic3r/Utils/QidiPrinterAgent.hpp         |  3 +-
 tests/slic3rutils/test_qidi_printer_agent.cpp | 10 +++++++
 7 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/src/slic3r/GUI/DeviceManager.cpp b/src/slic3r/GUI/DeviceManager.cpp
index 806616b5..59c143bf 100644
--- a/src/slic3r/GUI/DeviceManager.cpp
+++ b/src/slic3r/GUI/DeviceManager.cpp
@@ -3277,6 +3277,8 @@ int MachineObject::parse_json(std::string tunnel, std::string payload, bool key_
 
                 if (printer_agent_id == "qidi" && jj.contains("qidi_polar_cooler_available") && jj["qidi_polar_cooler_available"].is_boolean())
                     qidi_polar_cooler_available = jj["qidi_polar_cooler_available"].get<bool>();
+                if (printer_agent_id == "qidi" && jj.contains("qidi_polar_cooler_on") && jj["qidi_polar_cooler_on"].is_boolean())
+                    qidi_polar_cooler_on = jj["qidi_polar_cooler_on"].get<bool>();
                 if (printer_agent_id == "qidi" && jj.contains("qidi_detection") && jj["qidi_detection"].is_object()) {
                     const auto& detection = jj["qidi_detection"];
                     const auto enabled = detection.find("enable_noodle_detection");
