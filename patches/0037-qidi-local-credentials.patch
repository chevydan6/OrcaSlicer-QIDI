From ac2c5f6f1248def1243d1655d1ac0993c8e4713c Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:56:37 +0900
Subject: [PATCH] Apply Moonraker credential and binding semantics to QIDI
 devices

---
 src/slic3r/GUI/DeviceCore/DevManager.cpp |  7 +++---
 src/slic3r/GUI/DeviceManager.cpp         |  4 ++--
 src/slic3r/GUI/GUI_App.cpp               |  6 ++---
 src/slic3r/Utils/NetworkAgentFactory.hpp |  7 ++++++
 tests/slic3rutils/test_device_access.cpp | 30 ++++++++++++++----------
 5 files changed, 33 insertions(+), 21 deletions(-)

diff --git a/src/slic3r/GUI/DeviceCore/DevManager.cpp b/src/slic3r/GUI/DeviceCore/DevManager.cpp
index b84e5bf5..aa97aab6 100644
--- a/src/slic3r/GUI/DeviceCore/DevManager.cpp
+++ b/src/slic3r/GUI/DeviceCore/DevManager.cpp
@@ -282,12 +282,13 @@ namespace Slic3r
             std::string bind_state      = j["bind_state"].get<std::string>();
 
             // Passive discovery must not replace another agent's saved binding.
-            if (get_current_printer_agent_id() == MOONRAKER_PRINTER_AGENT_ID) {
+            const auto current_agent_id = get_current_printer_agent_id();
+            if (uses_moonraker_authentication(current_agent_id)) {
                 if (AppConfig* config = get_app_config()) {
                     const auto& machines = config->get_local_machines();
                     auto it = machines.find(dev_id);
-                    if (it != machines.end() && it->second.printer_agent_id != MOONRAKER_PRINTER_AGENT_ID) {
-                        BOOST_LOG_TRIVIAL(warning) << "Ignoring Moonraker discovery for a device owned by another agent: " << dev_id;
+                    if (it != machines.end() && it->second.printer_agent_id != current_agent_id) {
+                        BOOST_LOG_TRIVIAL(warning) << "Ignoring Moonraker-family discovery for a device owned by another agent: " << dev_id;
                         return;
                     }
                 }
diff --git a/src/slic3r/GUI/DeviceManager.cpp b/src/slic3r/GUI/DeviceManager.cpp
index 0cefe8f6..6e837861 100644
--- a/src/slic3r/GUI/DeviceManager.cpp
+++ b/src/slic3r/GUI/DeviceManager.cpp
@@ -533,7 +533,7 @@ bool MachineObject::HasRecentLanMessage()
 
 bool MachineObject::has_access_right() const
 {
-    return !m_access_revoked && (printer_agent_id == MOONRAKER_PRINTER_AGENT_ID || !get_access_code().empty());
+    return !m_access_revoked && (uses_moonraker_authentication(printer_agent_id) || !get_access_code().empty());
 }
 
 void MachineObject::revoke_access()
@@ -2730,7 +2730,7 @@ int MachineObject::connect()
 
         // Refresh credentials from the matching preset for connections that bypass GUI_App::select_machine().
         const std::string print_host = config.opt_string("print_host");
-        if (printer_agent_id == MOONRAKER_PRINTER_AGENT_ID && config.opt_string("printer_agent") == MOONRAKER_PRINTER_AGENT_ID &&
+        if (uses_moonraker_authentication(printer_agent_id) && config.opt_string("printer_agent") == printer_agent_id &&
             !print_host.empty() && dev_id_from_address(print_host, config.opt_string("printhost_port")) == get_dev_id()) {
             password = config.opt_string("printhost_apikey");
             use_ssl  = boost::istarts_with(print_host, "https://");
diff --git a/src/slic3r/GUI/GUI_App.cpp b/src/slic3r/GUI/GUI_App.cpp
index 52c2fe55..edaad9d3 100644
--- a/src/slic3r/GUI/GUI_App.cpp
+++ b/src/slic3r/GUI/GUI_App.cpp
@@ -4399,7 +4399,7 @@ void GUI_App::switch_printer_agent()
             if (!print_host.empty()) {
                 const std::string dev_id = MachineObject::dev_id_from_address(print_host, config.opt_string("printhost_port"));
                 MachineObject* sel = m_device_manager->get_selected_machine();
-                const bool access_code_changed = effective_agent_id == MOONRAKER_PRINTER_AGENT_ID && sel &&
+                const bool access_code_changed = uses_moonraker_authentication(effective_agent_id) && sel &&
                                                  sel->get_access_code() != config.opt_string("printhost_apikey");
                 if (!sel || sel->get_dev_id() != dev_id || access_code_changed)
                     select_machine(effective_agent_id);
@@ -4481,7 +4481,7 @@ void GUI_App::select_machine(const std::string& agent_id)
     }
     std::string port = host_cfg->opt_string("printhost_port");
     std::string access_code = host_cfg->opt_string("printhost_apikey");
-    if (access_code.empty() && agent_id != MOONRAKER_PRINTER_AGENT_ID)
+    if (access_code.empty() && !uses_moonraker_authentication(agent_id))
         access_code = "88888888";
 
     // Generate dev_id from host and port
@@ -4518,7 +4518,7 @@ void GUI_App::select_machine(const std::string& agent_id)
             return;
         }
         BOOST_LOG_TRIVIAL(info) << __FUNCTION__ << ": created new machine dev_id=" << dev_id;
-    } else if (agent_id == MOONRAKER_PRINTER_AGENT_ID && existing->printer_agent_id == agent_id &&
+    } else if (uses_moonraker_authentication(agent_id) && existing->printer_agent_id == agent_id &&
                (!existing->has_access_right() || existing->get_access_code() != access_code)) {
         existing->set_access_code(access_code);
     }
diff --git a/src/slic3r/Utils/NetworkAgentFactory.hpp b/src/slic3r/Utils/NetworkAgentFactory.hpp
index ea275861..bab33db7 100644
--- a/src/slic3r/Utils/NetworkAgentFactory.hpp
+++ b/src/slic3r/Utils/NetworkAgentFactory.hpp
@@ -20,6 +20,13 @@ static constexpr char ORCA_PRINTER_AGENT_ID[] = "orca";
 static constexpr char BBL_PRINTER_AGENT_ID[] = "bbl";
 static constexpr char MOONRAKER_PRINTER_AGENT_ID[] = "moonraker";
 
+// Both built-ins use Moonraker HTTP authentication, where a trusted LAN can
+// legitimately have no API key. Server-side authorization still applies.
+inline bool uses_moonraker_authentication(const std::string& agent_id)
+{
+    return agent_id == MOONRAKER_PRINTER_AGENT_ID || agent_id == "qidi";
+}
+
 // Factory function type for creating printer agents
 using PrinterAgentFactory =
     std::function<std::shared_ptr<IPrinterAgent>(std::shared_ptr<ICloudServiceAgent> cloud_agent, const std::string& log_dir)>;
diff --git a/tests/slic3rutils/test_device_access.cpp b/tests/slic3rutils/test_device_access.cpp
index e45d8677..50242f82 100644
--- a/tests/slic3rutils/test_device_access.cpp
+++ b/tests/slic3rutils/test_device_access.cpp
@@ -11,6 +11,7 @@
 #include <catch2/catch_test_macros.hpp>
 #include <catch2/generators/catch_generators.hpp>
 #include <memory>
+#include <string>
 
 #include "libslic3r/AppConfig.hpp"
 #include "slic3r/GUI/DeviceCore/DevManager.h"
@@ -18,23 +19,24 @@
 #include "slic3r/Utils/IPrinterAgent.hpp"
 #include "slic3r/Utils/NetworkAgentFactory.hpp"
 #include "slic3r/Utils/MoonrakerPrinterAgent.hpp"
+#include "slic3r/Utils/QidiPrinterAgent.hpp"
 #include "slic3r/Utils/NetworkAgent.hpp"
 
 using namespace Slic3r;
 
-TEST_CASE("Moonraker permits an empty access code", "[DeviceAccess]")
+TEST_CASE("Moonraker and QIDI permit an empty access code", "[DeviceAccess]")
 {
     MachineObject machine(nullptr, nullptr, "test", "test_dev", "127.0.0.1");
-    machine.printer_agent_id = MOONRAKER_PRINTER_AGENT_ID;
+    machine.printer_agent_id = GENERATE(MOONRAKER_PRINTER_AGENT_ID, "qidi");
     machine.set_access_code("", false);
 
     REQUIRE(machine.has_access_right());
 }
 
-TEST_CASE("Moonraker logout revokes access until explicitly rebound", "[DeviceAccess]")
+TEST_CASE("Moonraker and QIDI logout revoke access until explicitly rebound", "[DeviceAccess]")
 {
     MachineObject machine(nullptr, nullptr, "test", "test_dev", "127.0.0.1");
-    machine.printer_agent_id = MOONRAKER_PRINTER_AGENT_ID;
+    machine.printer_agent_id = GENERATE(MOONRAKER_PRINTER_AGENT_ID, "qidi");
     const std::string code = GENERATE("", "configured-key");
     machine.set_access_code(code, false);
     REQUIRE(machine.has_access_right());
@@ -66,7 +68,7 @@ TEST_CASE("Revoked access prevents calls to the printer agent", "[DeviceAccess]"
     auto agent = std::make_shared<RecordingAgent>();
     NetworkAgent network(nullptr, agent);
     MachineObject machine(nullptr, &network, "test", "test_dev", "127.0.0.1");
-    machine.printer_agent_id = GENERATE(BBL_PRINTER_AGENT_ID, ORCA_PRINTER_AGENT_ID, MOONRAKER_PRINTER_AGENT_ID);
+    machine.printer_agent_id = GENERATE(BBL_PRINTER_AGENT_ID, ORCA_PRINTER_AGENT_ID, MOONRAKER_PRINTER_AGENT_ID, "qidi");
     machine.set_access_code("configured-key", false);
     REQUIRE(machine.connect() == 0);
     REQUIRE(agent->connections == 1);
@@ -84,7 +86,7 @@ TEST_CASE("Other printer agents require an access code", "[DeviceAccess]")
 {
     MachineObject machine(nullptr, nullptr, "test", "test_dev", "127.0.0.1");
     machine.printer_agent_id = GENERATE(
-        BBL_PRINTER_AGENT_ID, ORCA_PRINTER_AGENT_ID, "qidi", "snapmaker", "crealityprint", "plugin", "unknown");
+        BBL_PRINTER_AGENT_ID, ORCA_PRINTER_AGENT_ID, "snapmaker", "crealityprint", "plugin", "unknown");
 
     machine.set_access_code("", false);
     REQUIRE_FALSE(machine.has_access_right());
@@ -93,29 +95,31 @@ TEST_CASE("Other printer agents require an access code", "[DeviceAccess]")
     REQUIRE(machine.has_access_right());
 }
 
-TEST_CASE("Rebinding Moonraker with an empty key saves the machine", "[DeviceAccess]")
+TEST_CASE("Rebinding Moonraker and QIDI with an empty key saves the machine", "[DeviceAccess]")
 {
     AppConfig config;
     DeviceManager manager(nullptr, false, &config);
     MachineObject machine(&manager, nullptr, "test", "test_dev", "127.0.0.1");
-    machine.printer_agent_id    = MOONRAKER_PRINTER_AGENT_ID;
+    machine.printer_agent_id    = GENERATE(MOONRAKER_PRINTER_AGENT_ID, "qidi");
     machine.dev_connection_type = "lan";
     machine.revoke_access();
 
     machine.set_access_code("");
     const auto& machines = config.get_local_machines();
     REQUIRE(machines.count("test_dev") == 1);
-    REQUIRE(machines.at("test_dev").printer_agent_id == MOONRAKER_PRINTER_AGENT_ID);
+    REQUIRE(machines.at("test_dev").printer_agent_id == machine.printer_agent_id);
     REQUIRE(machines.at("test_dev").access_code.empty());
 }
 
-TEST_CASE("Moonraker discovery leaves another agent's saved machine alone", "[DeviceAccess]")
+TEST_CASE("Moonraker and QIDI discovery leave another agent's saved machine alone", "[DeviceAccess]")
 {
     AppConfig config;
-    NetworkAgent network(nullptr, std::make_shared<MoonrakerPrinterAgent>(""));
+    const bool qidi = GENERATE(false, true);
+    const std::shared_ptr<IPrinterAgent> agent = qidi ? std::make_shared<QidiPrinterAgent>("") : std::make_shared<MoonrakerPrinterAgent>("");
+    NetworkAgent network(nullptr, agent);
     DeviceManager manager(&network, false, &config);
 
-    const std::string owner = GENERATE(as<std::string>{}, ORCA_PRINTER_AGENT_ID, MOONRAKER_PRINTER_AGENT_ID);
+    const std::string owner = GENERATE(as<std::string>{}, ORCA_PRINTER_AGENT_ID, MOONRAKER_PRINTER_AGENT_ID, "qidi");
     BBLocalMachine saved;
     saved.dev_id           = "192.0.2.10:7125";
     saved.dev_ip           = saved.dev_id;
@@ -124,5 +128,5 @@ TEST_CASE("Moonraker discovery leaves another agent's saved machine alone", "[De
 
     manager.on_machine_alive(R"({"dev_name":"Klipper","dev_id":"192.0.2.10:7125","dev_ip":"192.0.2.10:7125",
         "dev_type":"","dev_signal":"0","connect_type":"lan","bind_state":"free"})");
-    REQUIRE((manager.get_local_machine(saved.dev_id) != nullptr) == (owner == MOONRAKER_PRINTER_AGENT_ID));
+    REQUIRE((manager.get_local_machine(saved.dev_id) != nullptr) == (owner == agent->get_agent_info().id));
 }
-- 
2.56.0

