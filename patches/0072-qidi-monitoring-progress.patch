+void QidiPrinterAgent::append_monitoring_status(const nlohmann::json& status, nlohmann::json& payload)
+{
+    // Reset unknown values on every snapshot, including job changes and invalid input.
+    auto& print = payload["print"];
+    print["layer_num"] = 0;
+    print["total_layer_num"] = 0;
+    print["mc_remaining_time"] = -1;
+    const auto stats = status.find("print_stats");
+    if (stats == status.end() || !stats->is_object()) return;
+    const auto state = stats->find("state"), filename = stats->find("filename");
+    if (state == stats->end() || (*state != "printing" && *state != "paused") ||
+        filename == stats->end() || !filename->is_string() || filename->get_ref<const std::string&>().empty()) return;
+    const auto info = stats->find("info");
+    if (info != stats->end() && info->is_object()) {
+        const auto current = info->find("current_layer"), total = info->find("total_layer");
+        if (current != info->end() && total != info->end() && current->is_number_integer() && total->is_number_integer() &&
+            *current >= 0 && *total > 0 && *total <= std::numeric_limits<int>::max() && *current <= *total) {
+            print["layer_num"] = *current;
+            print["total_layer_num"] = *total;
+        }
+    }
+    const auto sd = status.find("virtual_sdcard");
+    const auto elapsed = stats->find("print_duration");
+    if (sd == status.end() || !sd->is_object() || elapsed == stats->end() || !elapsed->is_number()) return;
+    const auto progress = sd->find("progress");
+    if (progress == sd->end() || !progress->is_number()) return;
+    const double fraction = progress->get<double>(), seconds = elapsed->get<double>();
+    if (!std::isfinite(fraction) || !std::isfinite(seconds) || fraction < 0.01 || fraction > 1 || seconds <= 0) return;
+    // File progress is a rough proxy for time and may vary with layer complexity.
+    const double minutes = seconds * (1.0 - fraction) / fraction / 60.0;
+    if (std::isfinite(minutes) && minutes <= std::numeric_limits<int>::max() / 60)
+        print["mc_remaining_time"] = static_cast<int>(std::ceil(minutes));
+}
