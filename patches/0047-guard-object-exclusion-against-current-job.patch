+bool QidiPrinterAgent::object_selection_is_current(const nlohmann::json& command, const nlohmann::json& status)
+{
+    if (!command.is_object() || !status.is_object()) return false;
+    const auto job = command.find("expected_job");
+    const auto selected = command.find("objects");
+    const auto stats = status.find("print_stats");
+    const auto exclusion = status.find("exclude_object");
+    if (job == command.end() || !job->is_string() || job->get_ref<const std::string&>().empty() ||
+        selected == command.end() || !selected->is_array() || selected->empty() ||
+        stats == status.end() || !stats->is_object() ||
+        exclusion == status.end() || !exclusion->is_object()) return false;
+    const auto filename = stats->find("filename");
+    const auto state = stats->find("state");
+    const auto objects = exclusion->find("objects");
+    if (filename == stats->end() || *filename != *job || state == stats->end() ||
+        (*state != "printing" && *state != "paused") || objects == exclusion->end() || !objects->is_array()) return false;
+    return std::all_of(selected->begin(), selected->end(), [&](const nlohmann::json& name) {
+        return name.is_string() && std::any_of(objects->begin(), objects->end(), [&](const nlohmann::json& object) {
+            return object.is_object() && object.contains("name") && object["name"] == name;
+        });
+    });
+}
