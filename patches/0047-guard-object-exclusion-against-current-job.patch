+TEST_CASE("QIDI object selection rejects a changed job before GUI status delivery", "[QidiPrinterAgent][Regression]")
+{
+    const nlohmann::json command{{"command", "qidi_exclude_objects"}, {"expected_job", "first.gcode"}, {"objects", {"cube"}}};
+    const nlohmann::json first{{"print_stats", {{"filename", "first.gcode"}, {"state", "printing"}}},
+                              {"exclude_object", {{"objects", {{{"name", "cube"}}}}}}};
+    CHECK(QidiPrinterAgent::object_selection_is_current(command, first));
+    const auto update = GENERATE(
+        nlohmann::json{{"print_stats", {{"filename", "second.gcode"}}}},
+        nlohmann::json{{"print_stats", {{"state", "standby"}}}},
+        nlohmann::json{{"exclude_object", {{"objects", {{{"name", "other"}}}}}}},
+        nlohmann::json{{"exclude_object", {{"objects", nullptr}}}});
+    QidiPrinterAgent agent("");
+    const auto latest = QidiPrinterAgentTestAccess::merge(agent, first, update);
+    CHECK_FALSE(QidiPrinterAgent::object_selection_is_current(command, latest));
+    // No GUI callback has run: the protocol cache alone must reject the command.
+    CHECK(agent.send_message("offline-fixture", nlohmann::json{{"print", command}}.dump(), 0, 0) == BAMBU_NETWORK_ERR_INVALID_RESULT);
+    auto missing_job = command;
+    missing_job.erase("expected_job");
+    CHECK_FALSE(QidiPrinterAgent::object_selection_is_current(missing_job, first));
+}
